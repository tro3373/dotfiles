#!/usr/bin/env bash

# shellcheck disable=SC1091
source "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/lib/task2_index"

main() {
  set -eo pipefail
  local dst
  dst=$(task2_index_path) || exit 1
  local pr_no=$1
  if [[ -z $pr_no ]]; then
    # 現在のブランチのPR番号を取得
    pr_no=$(gh pr view --json number -q .number 2>/dev/null)
    if [[ -z $pr_no ]]; then
      ilog "==> Input PR No! Press Enter to continue..(Cancel: Ctrl+C)"
      read -r pr_no
    fi
  fi
  if [[ -z $pr_no || ! $pr_no =~ ^[0-9]+$ ]]; then
    elog "==> Error: Invalid PR number. $pr_no"
    exit 1
  fi
  local body
  body=$(gh_pr_review_to_tasks "$pr_no")
  task2_index_append "$dst" <<<"$body"
  echo "$dst" | v
}
main "$@"
