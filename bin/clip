#!/usr/bin/env bash

command_name=$(basename "$0") && readonly command_name
readonly tty="${CLIP_TTY:-/dev/tty}"

usage() {
  cat <<EOU

Copy stdin to the os clipboard (local and over ssh).

  Usage:
      echo foo | $command_name
    Options
      -h|--help : Show this usage

  tmux 内  : tmux load-buffer -w (tmux が OSC52 で端末へ送る)
  ssh 先   : /dev/tty へ OSC52
  local    : pbcopy / wl-copy / xclip

EOU
}

has() { command -v "${1}" >&/dev/null; }
is_remote() { [[ -n ${SSH_CONNECTION:-} || -n ${SSH_TTY:-} ]]; }

copy_osc52() {
  local encoded
  encoded=$(base64 | tr -d '\n')
  printf '\033]52;c;%s\a' "${encoded}" >"${tty}"
}

copy_local() {
  if has pbcopy; then
    pbcopy
    return
  fi
  if [[ -n ${WAYLAND_DISPLAY:-} ]] && has wl-copy; then
    wl-copy
    return
  fi
  if has xclip; then
    xclip -selection clipboard
    return
  fi
  echo "==> Error: No clipboard command (pbcopy / wl-copy / xclip)." >&2
  return 1
}

copy() {
  # tmux の copy-pipe から呼ばれると /dev/tty が無いので、tmux 内は ssh 先でも tmux に任せる
  if [[ -n ${TMUX:-} ]]; then
    tmux load-buffer -w -
    return
  fi
  if is_remote; then
    copy_osc52
    return
  fi
  copy_local
}

main() {
  set -euo pipefail
  case "${1:-}" in
    -h | --help)
      usage
      return 0
      ;;
  esac
  copy
}
main "$@"
