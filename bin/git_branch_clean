#!/usr/bin/env bash
# 要らなくなったローカルブランチ・origin のブランチ・backup tag を、fzf で選んで消す。
# usage: git_branch_clean [-a] [base]  (base 既定: origin/HEAD の指す先。無ければ main・master のうち在るもの)
#   -a  全件表示で開く。既定は 🟢 (消してよいもの) だけ
# fzf の中: a で 🟢 だけと全件を切り替え、/ で絞り込み (Esc でやめる)、Tab で複数選択、Enter で消す。
#   🟢  base に merge 済みか upstream が消えたブランチ、元のブランチが無い backup tag
#   ⚠️  未 merge のブランチ、元のブランチが残っている backup tag。選ぶと消す前に y/N を聞く
# 保護ブランチ・base・checkout 中のローカルブランチは候補に出ない。
# backup tag: `backup/<ブランチ名>` か `backup/<ブランチ名>-<YYYYmmdd>-<HHMMSS>`。

readonly protected_branches=(develop main master)
readonly log_format='%Cred%h %Cgreen(%cd)%Creset -%C(yellow)%d%Creset %s %C(bold blue)<%an>%Creset'
# shellcheck disable=SC1091
source "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/lib/fzf_pick"

initialize() {
  local arg
  for arg in "$@"; do
    case "${arg}" in
      -a) view=all ;;
      -*)
        echo "==> Error: unknown option: ${arg}" >&2
        return 2
        ;;
      *) base="${arg}" ;;
    esac
  done
  [[ -n ${base} ]] && return
  base=$(default_base)
}

# origin/HEAD が無い repo (remote が無い・set-head していない) では、main・master のうち在るものを使う。
default_base() {
  local head
  if head=$(git symbolic-ref --short -q refs/remotes/origin/HEAD); then
    echo "${head#origin/}"
    return
  fi
  git for-each-ref --format '%(refname:lstrip=-1)' \
    refs/heads/main refs/heads/master refs/remotes/origin/main refs/remotes/origin/master | head -n 1
}

# merge 済みの判定に使う ref。origin に base があればそれ、無ければ local の base。
resolve_base_ref() {
  local ref
  ref=$(git for-each-ref --sort=-refname --format '%(refname)' "refs/remotes/origin/${base}" "refs/heads/${base}" | head -n 1)
  if [[ -z ${ref} ]]; then
    echo "==> Error: base のブランチが見つからない: '${base}'。引数で渡す" >&2
    return 1
  fi
  echo "${ref}"
}

has_origin() {
  git remote | grep -qx origin
}

# 候補は 1 行 1 件の `<state>\t<kind>\t<name>\t<reason>`。
# state は safe か risky、kind は local・remote・tag。
list_local() {
  git for-each-ref refs/heads --merged "${base_ref}" --format '%(refname:lstrip=2)' |
    sed 's/.*/safe\tlocal\t&\tmerged/'
  git for-each-ref refs/heads --no-merged "${base_ref}" --format '%(refname:lstrip=2)%09%(upstream:track)' |
    awk -F'\t' -v OFS='\t' '
      $2 == "[gone]" { print "safe", "local", $1, "gone (upstream が消えた)"; next }
      { print "risky", "local", $1, "未 merge" }
    '
}

list_remote() {
  git for-each-ref refs/remotes/origin --merged "${base_ref}" --format '%(refname:lstrip=3)' |
    sed 's/.*/safe\tremote\t&\tmerged/'
  git for-each-ref refs/remotes/origin --no-merged "${base_ref}" --format '%(refname:lstrip=3)' |
    sed 's/.*/risky\tremote\t&\t未 merge/'
}

list_tags() {
  local branches
  branches=$(git for-each-ref refs/heads --format '%(refname:lstrip=2)')
  git tag -l 'backup/*' | awk -v OFS='\t' -v branches="${branches}" '
    BEGIN { n = split(branches, b, "\n"); for (i = 1; i <= n; i++) alive[b[i]] = 1 }
    {
      name = $0
      sub(/^backup\//, "", name)
      stamped = name
      sub(/-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9]$/, "", stamped)
    }
    (name in alive) || (stamped in alive) { print "risky", "tag", $0, "ブランチあり"; next }
    { print "safe", "tag", $0, "ブランチ無し" }
  '
}

checked_out_branches() {
  git worktree list --porcelain | sed -n 's#^branch refs/heads/##p'
}

exclude() {
  local skip
  skip=$(printf '%s\n' "${protected_branches[@]}" "${base}" "$@")
  awk -F'\t' -v skip="${skip}" '
    BEGIN { n = split(skip, s, "\n"); for (i = 1; i <= n; i++) ex[s[i]] = 1 }
    !($3 in ex)
  '
}

list_candidates() {
  list_local | exclude "$(checked_out_branches)"
  list_remote | exclude HEAD
  list_tags
}

# 出力は `<state>\t<kind>\t<name>\t<ref>\t<表示>`。🟢 を先に、種類・名前の順に並べる。
render() {
  sort -t$'\t' -k1,1r -k2,2 -k3,3 | awk -F'\t' -v OFS='\t' '
    BEGIN {
      mark["safe"] = "🟢"; mark["risky"] = "⚠️"
      icon["local"] = "💻"; icon["remote"] = "☁️"; icon["tag"] = "🔖"
      color["local"] = 36; color["remote"] = 35; color["tag"] = 33
      prefix["local"] = "refs/heads/"; prefix["remote"] = "refs/remotes/origin/"; prefix["tag"] = "refs/tags/"
    }
    {
      shown = sprintf("%s %s \033[%dm%-6s %-44s\033[0m %s", mark[$1], icon[$2], color[$2], $2, $3, $4)
      print $1, $2, $3, prefix[$2] $3, shown
    }
  '
}

main() {
  set -euo pipefail
  local view=safe base='' base_ref
  initialize "$@"
  if has_origin; then
    git fetch --prune
  fi
  base_ref=$(resolve_base_ref)
  local selected
  local preview="git log --color=always --graph --pretty=format:'${log_format}' --abbrev-commit --date=format-local:'%Y-%m-%d %H:%M:%S' -n 50 {4}"
  selected=$(list_candidates | render | fzf_pick_select "${view}" 5 4 "${preview}")
  [[ -z ${selected} ]] && return
  fzf_pick_confirm_risky "${selected}" 5
  fzf_pick_delete_kind "${selected}" local git branch -D
  fzf_pick_delete_kind "${selected}" tag git tag -d
  fzf_pick_delete_kind "${selected}" remote git push origin --delete
}
main "$@"
