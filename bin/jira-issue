#!/usr/bin/env bash

# Create or open Jira sub-task(s) for a parent issue.
#
# The config file is selected per-project from JIRA_PROJECT:
#   ${XDG_CONFIG_HOME:-~/.config}/.jira/.config.<JIRA_PROJECT>.yml
# If it is missing, `jira init` runs once, reusing the connection settings
# (server/login/auth/installation) from the most recent existing config in
# that directory when present (otherwise jira init prompts for everything).
# This matters because issue type names differ per project (team-managed
# projects in particular), and `jira issue create` decides the sub-task parent
# from the per-project issue type cache, not from the server.
#
# Every mode converts the issue body AND all of its comments. The conversion
# goes through the raw Jira API JSON (`--raw`) and bin/adf2md, so headings,
# nested lists and fenced code blocks survive; comments land one per block under
# a `- Comments` heading, oldest first.
#
# Open (default): pick issue(s) with fzf, convert them to task-list markdown,
# then view them in nvim, one tab per issue.
#   jira-issue
# To tasks: same pick + convert, but append the result to .tasks.md via
# `tasks -a` instead of opening nvim.
#   jira-issue -t
# To GitHub: same pick + convert, but create one GitHub issue per pick,
# titled "[KEY] SUMMARY" with the converted markdown as its body. The created
# URL is linked back to the Jira issue as a web link, then the same markdown is
# appended to .tasks.md. An issue whose title already carries that [KEY] is
# skipped (and so is its task), so re-picking the same issue never creates a
# duplicate. Creation only; closing stays manual.
#   jira-issue -g [-R owner/repo]
# Both modes mark the appended task with a `tracker:` line so /task can read
# and comment on the issue(s) it came from; -g records the GitHub issue it
# just created alongside the Jira key.
# These modes pick several issues with TAB; each pick becomes its own
# tab / task / GitHub issue.
# Create (stdin):
#   cat task.md | jira-issue add
#     - [ ] タスク名
#       - タスクの説明1
#         - タスクの説明1の詳細
#       - タスクの説明2
#
# Required environment variables:
#   JIRA_PROJECT      - Jira project key (also selects the config file)
#
# Required for `add` (optional filters for the default open view):
#   JIRA_ISSUE_TYPE   - Sub-task issue type name for THIS project
#   JIRA_ISSUE_PARENT - Parent task key
#
# Optional environment variables:
#   JIRA_ASSIGNEE     - Assignee (username / email / display name).
#                       Defaults to "$$" (current logged-in user).
#   JIRA_CONFIG_FILE  - Override the per-project config path.

command_name=$(basename "$0") && readonly command_name
# Task-list markdown line ("- [ ] Title"). This script both writes the format
# (issue_to_tasks) and reads it back (process_tasks, create_gh_issues), so the
# pattern lives in one place instead of once per parser.
readonly task_re='^- \[[x ]\] (.*)$'
# repo args for every gh call of -g|--to-gh: set once by set_gh_repo_args, read
# by gh_issue_exists / create_gh_issues. Empty means "let gh resolve the repo
# from the current directory's git remote".
gh_repo_args=()
# ADF (Jira の本文 JSON) -> markdown の変換器。PATH ではなく隣を見る: この
# スクリプトを source するテストや、PATH を通していない環境でも同じものを使う。
adf2md_bin=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/adf2md && readonly adf2md_bin
has() { command -v "${1}" >&/dev/null; }
hass() { for _arg in "$@"; do has "$_arg" || die "==> No $_arg command exist."; done; }
_ink() { if has ink; then ink "$@"; else cat - 1>&2; fi; }
#_log() { echo "$(date +"%Y-%m-%d %H:%M:%S") $(test ! -t 0 && cat -) ${@:2}" | _ink "$1"; }
# shellcheck disable=SC2145
_log() { echo "$(date +"%Y-%m-%d %H:%M:%S") ${@:2}" | _ink "$1"; }
log() { _log white "$*"; }
info() { _log cyan "$*"; }
warn() { _log yellow "$*"; }
die() { _log red "$*" && exit 1; }

usage() {
  cat <<EOF

$command_name [-t|--to-tasks] [-g|--to-gh [-R owner/repo]] [-a|--add]

  Open (default): pick issue(s) with fzf, convert them to task-list markdown,
  then view them in nvim, one tab per issue. TAB toggles a pick.
  Options:
    -t, --to-tasks  Append the selected issue(s) to .tasks.md instead of opening
                    them in nvim
    -g, --to-gh     Create a GitHub issue per selected issue instead of
                    opening them in nvim, link its URL back to the Jira issue,
                    then append it to the .tasks.md of the current directory.
                    The title carries a [KEY] prefix; an issue whose title
                    already has that [KEY] is skipped
    -R, --repo      Target repo (owner/repo) for -g. Defaults to the repo gh
                    resolves from the current directory's git remote
    -a, --add       Create sub-task(s) from stdin (task-list markdown)
    -h, --help      Show this help message and exit

EOF
}

require_env() {
  local name=$1
  if [[ -z ${!name:-} ]]; then
    echo "==> Error: ${name} is not set" >&2
    return 1
  fi
}

validate_env() {
  require_env JIRA_PROJECT
}

validate_add_env() {
  # Sub-task creation needs an explicit type and parent; the open view treats
  # both as optional filters.
  require_env JIRA_ISSUE_TYPE
  require_env JIRA_ISSUE_PARENT
}

read_config_value() {
  # First top-level "<key>: <value>" scalar from a jira config yaml.
  local file=$1 key=$2 line
  while IFS= read -r line; do
    if [[ ${line} == "${key}: "* ]]; then
      printf '%s\n' "${line#"${key}": }"
      return 0
    fi
  done <"${file}"
}

newest_config() {
  # Most recently modified jira config in the dir, used to seed connection
  # settings for a new project. Empty if none exist yet (first ever run).
  local dir=$1 newest="" f
  for f in "${dir}"/.config*.yml; do
    [[ -f ${f} ]] || continue
    [[ -z ${newest} || ${f} -nt ${newest} ]] && newest=${f}
  done
  printf '%s\n' "${newest}"
}

init_config() {
  # Create the per-project config once. Seed the connection settings from the
  # most recent existing config so only the board prompt (if any) needs the
  # terminal; on the very first run none exist, so jira init asks for them.
  local donor
  donor=$(newest_config "${JIRA_CONFIG_FILE%/*}")
  echo "==> No config for project ${JIRA_PROJECT}; running 'jira init' -> ${JIRA_CONFIG_FILE}" >&2
  local args=(--project "${JIRA_PROJECT}")
  if [[ -n ${donor} ]]; then
    echo "==> Reusing connection settings from ${donor}" >&2
    local installation server login auth_type
    installation=$(read_config_value "${donor}" installation)
    server=$(read_config_value "${donor}" server)
    login=$(read_config_value "${donor}" login)
    auth_type=$(read_config_value "${donor}" auth_type)
    [[ -n ${installation} ]] && args+=(--installation "${installation,,}")
    [[ -n ${server} ]] && args+=(--server "${server}")
    [[ -n ${login} ]] && args+=(--login "${login}")
    [[ -n ${auth_type} ]] && args+=(--auth-type "${auth_type}")
  fi
  jira init "${args[@]}" </dev/tty
}

resolve_config() {
  # Pick the per-project config from JIRA_PROJECT; init it on first use.
  local dir="${XDG_CONFIG_HOME:-${HOME}/.config}/.jira"
  export JIRA_CONFIG_FILE="${JIRA_CONFIG_FILE:-${dir}/.config.${JIRA_PROJECT}.yml}"
  [[ -f ${JIRA_CONFIG_FILE} ]] || init_config
}

validate_stdin() {
  if [[ -t 0 ]]; then
    echo "==> Error: No stdin input" >&2
    echo "Usage: cat task.md | $0 add" >&2
    return 1
  fi
}

emit_task() {
  [[ -z ${summary} ]] && return 0
  echo "==> Creating: ${summary}" >&2
  printf '%s' "${body}" |
    jira issue create \
      -p "${JIRA_PROJECT}" \
      -t "${JIRA_ISSUE_TYPE}" \
      -P "${JIRA_ISSUE_PARENT}" \
      -s "${summary}" \
      -a "${assignee}" \
      --no-input
  summary=""
  body=""
}

process_tasks() {
  local line=""
  local summary=""
  local body=""
  while IFS='' read -r line || [[ -n ${line} ]]; do
    if [[ ${line} =~ ${task_re} ]]; then
      emit_task
      summary="${BASH_REMATCH[1]}"
      body=""
      continue
    fi
    [[ -z ${summary} ]] && continue
    body+="${line#  }"$'\n'
  done
  emit_task
}

view_issue() {
  # --plain ではなく --raw。--plain は glamour を通るので 120 桁で折り返され、
  # code fence は言語ごとインデントに潰れ、コメントの境界も日付の見た目でしか
  # 追えなくなる。raw の JSON はそれを全部保ったままで、変換は bin/adf2md 側の
  # 決定的な処理になる。
  jira issue view "$1" --raw
}

list_issues_plain() {
  # Tab-delimited list for fzf. TYPE/PARENT are optional filters, so only pass
  # them when set (lets listing work without a fixed type/parent).
  local args=(-p "${JIRA_PROJECT}")
  [[ -n ${JIRA_ISSUE_TYPE:-} ]] && args+=(-t "${JIRA_ISSUE_TYPE}")
  [[ -n ${JIRA_ISSUE_PARENT:-} ]] && args+=(-P "${JIRA_ISSUE_PARENT}")
  jira issue list "${args[@]}" \
    --plain --no-headers --columns KEY,SUMMARY,STATUS,ASSIGNEE
}

insert_tracker() {
  # Put the `tracker:` marker (~/.claude/skills/task/references/tracker.md) right
  # under the title line of a converted issue. /task reads that marker to know
  # which issues a task belongs to, so whoever appends the task has to write it;
  # a task without one never triggers the issue integration at all.
  # Only the title line can match: issue_to_tasks indents every body line by two
  # spaces, so nothing below it starts with "- [ ]".
  local tracker=$1 line
  while IFS='' read -r line || [[ -n ${line} ]]; do
    printf '%s\n' "${line}"
    if [[ ${line} =~ ${task_re} ]]; then
      printf '  - tracker: %s\n' "${tracker}"
    fi
  done
}

# jira の日時 ("2021-11-24T09:00:00.000+0000") をローカルの分精度に落とす。
# 秒とミリ秒はタスクの本文で追う情報ではないし、桁が揃わないと読みにくい。
format_datetime() {
  date -d "$1" '+%Y-%m-%d %H:%M' 2>/dev/null || printf '%s' "$1"
}

indent_lines() {
  # stdin の各行を $1 個の空白で字下げし、行末の空白と空行を落とす。タスク 1 件が
  # 画面に収まることのほうが、markdown の段落区切りや hardBreak の行末 2 スペース
  # より効く。空白だけの行は行末を落とした時点で空行になり、まとめて消える。
  # 例外はフェンスの中身だけ: そこの空行と行末空白はコードの一部で、消すと中身が
  # 変わる (区切りの ``` 行自体は本文ではないので落とす)。
  local pad=$1 line in_fence=0 is_fence
  local fence_re='^[[:space:]]*```'
  while IFS='' read -r line || [[ -n ${line} ]]; do
    is_fence=0
    [[ ${line} =~ ${fence_re} ]] && {
      is_fence=1
      in_fence=$((1 - in_fence))
    }
    ((in_fence == 0 || is_fence)) && line="${line%"${line##*[![:space:]]}"}"
    if [[ -z ${line} ]]; then
      ((in_fence)) || continue
      printf '\n'
      continue
    fi
    printf '%*s%s\n' "${pad}" '' "${line}"
  done
}

issue_to_tasks() {
  # Convert the raw `jira issue view --raw` JSON into markdown task-list format:
  #
  #   - [ ] [KEY] Summary
  #     <description as markdown>
  #     - Comments
  #       - Author • 2021-11-24 09:00
  #         <comment body as markdown>
  #     - View this issue on Jira: <url>
  #
  # The body comes from bin/adf2md, so headings, nested lists and fenced code
  # blocks (language included) survive. Everything below the title is indented
  # by two spaces, which is what keeps the whole issue one task: bin/tasks ends
  # a task block at the next line starting with "- " or "#" in column 0.
  local raw key summary desc self browse total shown i comment author created
  raw=$(cat)
  key=$(jq -r '.key // ""' <<<"${raw}")
  summary=$(jq -r '.fields.summary // ""' <<<"${raw}")
  printf -- '- [ ] [%s] %s\n' "${key}" "${summary}"

  desc=$(jq -c '.fields.description' <<<"${raw}" | "${adf2md_bin}")
  [[ -n ${desc} ]] && printf '%s\n' "${desc}" | indent_lines 2

  # jira は comments を作成順 (古い順) で返すので、そのまま辿れば時系列になる。
  shown=$(jq -r '.fields.comment.comments | length' <<<"${raw}")
  total=$(jq -r '.fields.comment.total // 0' <<<"${raw}")
  # --raw は --comments を見ない (raw path は filter を通さない) ので、件数を絞る
  # 手段が無い代わりに欠けたことにも気付けない。数が合わなければ黙って捨てない。
  if ((total > shown)); then
    warn "==> ${key}: got ${shown} of ${total} comments; the rest are not in this task"
  fi
  if ((shown > 0)); then
    printf '  - Comments\n'
    for ((i = 0; i < shown; i++)); do
      comment=$(jq -c --argjson i "${i}" '.fields.comment.comments[$i]' <<<"${raw}")
      author=$(jq -r '.author.displayName // .author.name // "(unknown)"' <<<"${comment}")
      created=$(format_datetime "$(jq -r '.created // ""' <<<"${comment}")")
      printf '    - %s • %s\n' "${author}" "${created}"
      jq -c '.body' <<<"${comment}" | "${adf2md_bin}" | indent_lines 6
    done
  fi

  # jira issue view の footer と同じ導線を残す。server は config ではなく .self
  # から取る: -R 越しでも、config を読めないテストでも同じ URL になる。
  self=$(jq -r '.self // ""' <<<"${raw}")
  browse=${self%%/rest/*}
  if [[ -n ${browse} && ${browse} != "${self}" && -n ${key} ]]; then
    printf '  - View this issue on Jira: %s/browse/%s\n' "${browse}" "${key}"
  fi
}

append_to_tasks() {
  # `tasks -a` turns one call into one task, so each issue is appended on its own.
  local key
  for key in "$@"; do
    view_issue "${key}" | issue_to_tasks |
      insert_tracker "jira=${key}" | tasks -a
  done
}

open_in_nvim() {
  # nvim fills a single buffer from stdin, so several issues need real files:
  # one <KEY>.md per pick, opened as tabs. The files are scratch (the previous
  # stdin buffer was unnamed too), so drop them once nvim exits.
  local tmpdir key status=0
  local -a files=()
  tmpdir=$(mktemp -d)
  for key in "$@"; do
    view_issue "${key}" | issue_to_tasks >"${tmpdir}/${key}.md"
    files+=("${tmpdir}/${key}.md")
  done
  # Hold nvim's status so `set -e` cannot skip the cleanup on :cq or a crash.
  nvim -p "${files[@]}" || status=$?
  rm -rf "${tmpdir}"
  return "${status}"
}

set_gh_repo_args() {
  # -R owner/repo (--repo) だけを受ける。未指定なら空のままにして、gh に
  # カレントディレクトリの git remote から repo を解決させる。
  # 綴り違いを黙って読み飛ばすと、意図しない repo に issue を作ってしまうので
  # 知らない引数は落とす。
  gh_repo_args=()
  [[ -n ${1:-} ]] || return 0
  if [[ ${1} != "-R" && ${1} != "--repo" ]]; then
    die "==> Error: Unknown option: ${1}"
  fi
  if [[ -z ${2:-} ]]; then
    die "==> Error: ${1} requires owner/repo"
  fi
  gh_repo_args=(-R "$2")
}

gh_issue_exists() {
  # GitHub の検索はタイトルの記号を落とすため "[KEY]" は "KEY 番号" のフレーズ
  # 検索になり、無関係な issue にも当たる。引いたタイトルを [KEY] 前置で絞り直す
  # ([K-1] と [K-10] の取り違えも閉じる)。
  # 検索の失敗 (認証切れ・rate limit・repo 解決失敗) を「存在しない」と取り違える
  # と二重作成になるので、パイプに畳まず gh の終了コードを見る。
  local key=$1 titles
  if ! titles=$(gh issue list "${gh_repo_args[@]}" \
    --search "\"[${key}]\" in:title" --state all --limit 100 \
    --json title --jq '.[].title'); then
    die "==> Error: Failed to search GitHub issues for [${key}]"
  fi
  grep -q "^\[${key}\]" <<<"${titles}"
}

link_gh_issue_to_jira() {
  # 作成した GH issue を Jira 側からも辿れるようにする。Web Link は Jira の
  # リンク欄に出るので、コメント欄を埋めない。
  # ここで失敗したまま進むと、次の -g は「GH issue が既にある」でスキップして
  # しまい、リンクが永久に付かない。手で貼れるよう URL を出して止める。
  if ! jira issue link remote "${key}" "${url}" "${title}"; then
    die "==> Error: Created ${url} but could not link it to ${key}; add the link by hand"
  fi
}

create_gh_issue() {
  # gh は作成した issue の URL を stdout に出す。行の並びに依存しないよう
  # https:// で始まる行だけを拾う。
  local out
  if ! out=$(gh issue create "${gh_repo_args[@]}" \
    --title "${title}" --body "${markdown}"); then
    die "==> Error: Failed to create a GitHub issue for ${key}"
  fi
  url=$(grep -m1 '^https://' <<<"${out}") || url=""
  if [[ -z ${url} ]]; then
    die "==> Error: Created an issue for ${key} but found no URL in: ${out}"
  fi
  echo "==> Created: ${url}" >&2
}

add_gh_task() {
  # 作成した issue を cwd の .tasks.md にも積む。3 手順の最後に置く: tasks は
  # git worktree と .tasks.md を要求するのに対し -R は「その repo に居なくてよい」
  # ための引数なので、ここが一番落ちやすい。先に link を済ませておけば、落ちても
  # 失うのはタスク 1 件だけで、手で足せる。
  # tracker の owner/repo と番号は作成した URL だけから取る。-R で別 repo に作る
  # ことがあるので、cwd の repo を前提にすると /task が無い issue へ投稿しに行く。
  # host も github.com に限る: tracker の `gh=owner/repo#NN` は host を持たず、
  # /task は github.com へ投稿するため、GHE の URL は黙って別の issue を指す。
  local url_re='^https://github\.com/([^/]+/[^/]+)/issues/([0-9]+)'
  if [[ ! ${url} =~ ${url_re} ]]; then
    die "==> Error: Cannot build a tracker from ${url}; add the task by hand"
  fi
  local tracker="gh=${BASH_REMATCH[1]}#${BASH_REMATCH[2]} jira=${key}"
  if ! printf '%s\n' "${markdown}" | insert_tracker "${tracker}" | tasks -a; then
    die "==> Error: Created and linked ${url} but could not append its task; add it by hand with: ${tracker}"
  fi
}

create_gh_issues() {
  # 突合キーは GH issue タイトルの [KEY] prefix。マッピングファイルを持たない
  # 代わりに毎回検索し、同じ issue を選び直しても二重作成しない。
  # 作成と Jira への貼り返しのみ。close はしない (状態同期は範囲外)。
  local key markdown title url
  echo "==> Target repo: ${gh_repo_args[1]:-git remote of ${PWD}}" >&2
  for key in "$@"; do
    if gh_issue_exists "${key}"; then
      echo "==> Skip (already exists): [${key}]" >&2
      continue
    fi
    markdown=$(view_issue "${key}" | issue_to_tasks)
    # 1 行目が "- [ ] [KEY] SUMMARY"。ここから題名を取れば view は 1 回で済む。
    if [[ ! ${markdown%%$'\n'*} =~ ${task_re} ]]; then
      die "==> Error: No title line in the converted issue: ${key}"
    fi
    title=${BASH_REMATCH[1]}
    # SUMMARY が空だと "[KEY]" だけの issue ができ、以後その KEY は既存扱いで
    # 永久にスキップされる。作る前に落とす。
    if [[ ! ${title#"[${key}]"} =~ [^[:space:]] ]]; then
      die "==> Error: No summary for ${key}"
    fi
    echo "==> Creating: ${title}" >&2
    create_gh_issue
    link_gh_issue_to_jira
    add_gh_task
  done
}

issue_select_open() {
  # Pick issue(s) with fzf (KEY is the first tab field, TAB toggles a pick),
  # convert each to task list markdown, then hand it to the sink the mode
  # picks: nvim (default), .tasks.md (to-tasks) or GitHub (to-gh).
  # JIRA_CONFIG_FILE is exported, so the preview/view subprocesses inherit
  # the per-project config.
  local mode="${1:-open}"
  local lines
  lines=$(
    list_issues_plain |
      fzf --multi --delimiter '\t' \
        --preview 'jira issue view {1} --plain' \
        --preview-window 'right,60%,wrap' \
        --select-1 --exit-0
  ) || return 0
  [[ -z ${lines} ]] && return 0
  local -a keys=()
  mapfile -t keys < <(cut -f1 <<<"${lines}")
  # Same pick + convert; only the sink differs.
  if [[ ${mode} == to-tasks ]]; then
    append_to_tasks "${keys[@]}"
    return 0
  fi
  if [[ ${mode} == to-gh ]]; then
    create_gh_issues "${keys[@]}"
    return 0
  fi
  open_in_nvim "${keys[@]}"
}

main() {
  set -euo pipefail
  if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
    usage
    return 0
  fi
  hass jira jq
  validate_env
  resolve_config
  if [[ ${1:-} == "-a" || ${1:-} == "--add" ]]; then
    validate_add_env
    local assignee="${JIRA_ASSIGNEE:-}"
    [[ -z ${assignee} ]] && assignee='$$'
    validate_stdin
    process_tasks
    return
  fi
  if [[ ${1:-} == "-t" || ${1:-} == "--to-tasks" ]]; then
    issue_select_open to-tasks
    return
  fi
  if [[ ${1:-} == "-g" || ${1:-} == "--to-gh" ]]; then
    shift
    set_gh_repo_args "$@"
    issue_select_open to-gh
    return
  fi
  issue_select_open
}
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
