#!/usr/bin/env bash

# ログイン中の Google アカウント (メールアドレス) の前方一致で、
# Chrome プロファイルのディレクトリ名 (Default, Profile N) を 1 行 1 件で出す。
# 値は --profile-directory にそのまま渡せる。該当なしは exit 1。
#
#   chrome-profile tro3373@   # => Profile 9
#
# Local State の info_cache が保つログイン中アカウントで引く。
# ディレクトリ名や表示名で引かないのは、前者が中身を表さず、後者が重複し得るため。

user_data_dir() {
  case "$OSTYPE" in
    darwin*) echo "$HOME/Library/Application Support/Google/Chrome" ;;
    *) echo "$HOME/.config/google-chrome" ;;
  esac
}

main() {
  set -euo pipefail
  local prefix=${1:-}
  if [[ -z $prefix ]]; then
    echo "Usage: chrome-profile <email-prefix>" >&2
    exit 2
  fi
  local dirs
  dirs=$(jq -r --arg p "$prefix" \
    '.profile.info_cache | to_entries[] | select(.value.user_name // "" | startswith($p)) | .key' \
    "$(user_data_dir)/Local State")
  [[ -z $dirs ]] && exit 1
  echo "$dirs"
}
main "$@"
