#!/usr/bin/env bash
# docker が見えないところで使っているディスクを、fzf で選んで空ける。
# usage: docker_clean [-a] [--apply]
#   -a       全件表示で開く。既定は 🟢 (消してよいもの) だけ
#   --apply  fzf を開かず、🟢 を全部消す
# fzf の中: a で 🟢 だけと全件を切り替え、/ で絞り込み (Esc でやめる)、Tab で複数選択、Enter で消す。
#   🟢  tag の無い (dangling) image、無名の volume。どの container も使っていない
#   ⚠️  止まった container、tag 付きで未使用の image、名前付きで未使用の volume、build cache。選ぶと消す前に y/N を聞く
# 使われている image・volume と、動いている container は候補に出ない。

readonly fzf_header='a: 🟢 だけ <=> 全件 | /: 絞り込み (Esc でやめる) | Tab: 複数選択 | Enter: 消す'

usage() {
  sed -n '2,/^$/{/^$/q;s/^# \{0,1\}//;p;}' "${BASH_SOURCE[0]}"
}

initialize() {
  local arg
  for arg in "$@"; do
    case "${arg}" in
      -h | --help)
        usage
        exit 0
        ;;
      -a) view=all ;;
      --apply) apply=true ;;
      *)
        echo "==> Error: unknown option: ${arg}" >&2
        return 2
        ;;
    esac
  done
}

cache_reclaimable() {
  local reclaimable
  reclaimable=$(docker system df --format '{{json .}}' | jq -r 'select(.Type == "Build Cache") | .Reclaimable')
  echo "${reclaimable%% *}"
}

list_candidates() {
  local cache
  cache=$(cache_reclaimable)
  docker system df -v --format '{{json .}}' | jq -r --arg cache "${cache}" '
    def anonymous: (.Labels // "") | contains("com.docker.volume.anonymous");
    def short_id: ltrimstr("sha256:") | .[:12];
    def short_name: if test("^[0-9a-f]{64}$") then .[:12] else . end;
    def own_size: split(" (")[0];
    (.Containers[] | select(.State | IN("exited", "created", "dead"))
      | ["risky", "container", .ID, .Names, (.Size | own_size), .State]),
    (.Images[] | select(.Containers == "0")
      | if .Tag == "<none>"
        then ["safe", "image", .ID, (.ID | short_id), .Size, "dangling"]
        else ["risky", "image", "\(.Repository):\(.Tag)", "\(.Repository):\(.Tag)", .Size, "tag 付き・未使用"]
        end),
    (.Volumes[] | select(.Links == "0")
      | if anonymous
        then ["safe", "volume", .Name, (.Name | short_name), .Size, "無名"]
        else ["risky", "volume", .Name, (.Name | short_name), .Size, "名前付き"]
        end),
    (if $cache != "" and $cache != "0B"
      then ["risky", "cache", "build-cache", "build cache", $cache, "未使用の cache"]
      else empty end)
    | @tsv'
}

render() {
  sort -s -t$'\t' -k1,1r | awk -F'\t' -v OFS='\t' '
    BEGIN {
      mark["safe"] = "🟢"; mark["risky"] = "⚠️"
      icon["container"] = "📦"; icon["image"] = "🖼️"; icon["volume"] = "💾"; icon["cache"] = "🧹"
      color["container"] = 33; color["image"] = 36; color["volume"] = 35; color["cache"] = 32
    }
    {
      shown = sprintf("%s %s \033[%dm%-9s %-34s %9s\033[0m %s", mark[$1], icon[$2], color[$2], $2, $4, $5, $6)
      print $1, $2, $3, shown
    }
  '
}

write_views() {
  local safe
  safe=$(awk -F'\t' '$1 == "safe"' <<<"${rows}")
  printf '\t\t\t%s\n%s\n' '🟢 消してよいものだけを表示中' "${safe}" | sed '/^$/d' >"${views}/safe"
  printf '\t\t\t%s\n%s\n' '全件を表示中 (⚠️ は消すと失う)' "${rows}" | sed '/^$/d' >"${views}/all"
  local -A other=([safe]=all [all]=safe)
  mv "${views}/${view}" "${views}/shown"
  mv "${views}/${other[${view}]}" "${views}/hidden"
}

select_targets() {
  local toggle="cd '${views}'; mv hidden swap; mv shown hidden; mv swap shown; cat shown"
  # shellcheck disable=SC2016 # FZF_INPUT_STATE は fzf が bind の実行時に渡す
  # fzf 0.74 は clear-query の直後に hide-input すると、一覧を絞り込まれたまま残す。search() で検索し直させる
  local leave_filter='case $FZF_INPUT_STATE in enabled) echo "clear-query+search()+hide-input+rebind(a,/)" ;; *) echo abort ;; esac'
  # shellcheck disable=SC2016 # {2} {3} は fzf が preview の実行時に展開する
  local preview='case {2} in cache) docker system df ;; *) docker inspect {3} ;; esac'
  local status=0
  fzf --multi --ansi --no-input \
    --with-shell 'bash -c' \
    --delimiter '\t' --with-nth 4 \
    --header-lines 1 --header "${fzf_header}" \
    --id-nth 3 \
    --bind "a:reload-sync(${toggle})" \
    --bind '/:show-input+unbind(a,/)' \
    --bind "esc:transform:${leave_filter}" \
    --preview "${preview}" \
    --preview-window=down,border-top,60% <"${views}/shown" || status=$?
  # fzf の終了コード: 1 は一致なし、130 は Esc・Ctrl-C で抜けた。2 はエラー
  case "${status}" in
    0 | 1 | 130) return 0 ;;
  esac
  return "${status}"
}

confirm_risky() {
  local risky answer
  risky=$(awk -F'\t' '$1 == "risky"' <<<"${selected}")
  [[ -z ${risky} ]] && return
  echo "==> ⚠️ 消すと失うものを含む:" >&2
  cut -f4 <<<"${risky}" >&2
  read -r -p '==> 消す? [y/N] ' answer || true
  [[ ${answer} == y ]] && return
  echo "==> 中止" >&2
  return 1
}

delete_kind() {
  local kind="$1"
  shift
  local -a targets
  mapfile -t targets < <(awk -F'\t' -v kind="${kind}" '$2 == kind { print $3 }' <<<"${selected}")
  [[ ${#targets[@]} -eq 0 ]] && return
  "$@" "${targets[@]}"
}

prune_cache() {
  if awk -F'\t' '$2 == "cache" { found = 1 } END { exit !found }' <<<"${selected}"; then
    docker builder prune -f
  fi
}

delete_selected() {
  delete_kind container docker rm
  delete_kind image docker rmi
  delete_kind volume docker volume rm
  prune_cache
}

apply_safe() {
  selected=$(awk -F'\t' '$1 == "safe"' <<<"${rows}")
  if [[ -z ${selected} ]]; then
    echo "==> 消してよいものは無い"
    return
  fi
  echo "==> 消す:"
  cut -f4 <<<"${selected}"
  delete_selected
}

main() {
  set -euo pipefail
  local view=safe apply=false rows selected views
  initialize "$@"
  rows=$(list_candidates | render)
  if [[ ${apply} == true ]]; then
    apply_safe
    return
  fi
  views=$(mktemp -d)
  # shellcheck disable=SC2064 # local 変数なので定義時に展開する
  trap "rm -rf '${views}'" EXIT
  write_views
  selected=$(select_targets)
  [[ -z ${selected} ]] && return
  confirm_risky
  delete_selected
}
main "$@"
