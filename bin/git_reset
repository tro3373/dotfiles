#!/usr/bin/env bash

command_name=$(basename "$0") && readonly command_name
has() { command -v "${1}" >&/dev/null; }
hass() { for _arg in "$@"; do has "$_arg" || die "==> No $_arg command exist."; done; }
_ink() { if has ink; then ink "$@"; else cat - 1>&2; fi; }
# shellcheck disable=SC2145
_log() { echo "$(date +"%Y-%m-%d %H:%M:%S") ${@:2}" | _ink "$1"; }
log() { _log white "$*"; }
info() { _log cyan "$*"; }
warn() { _log yellow "$*"; }
die() { _log red "$*" && exit 1; }
# stack の段数 (非空行数) を返す。空・未作成なら 0。
stack_depth() { [[ -s $marker ]] && grep -c '.' "$marker" || echo 0; }
# stack を先頭から keep 行だけ残す (それより下=新しい undo を捨てる)。keep=0 で空。
truncate_stack() {
  local keep="$1" tmp
  tmp="$(mktemp "${marker}.XXXXXX")" # marker と同一 dir => mv が atomic rename
  head -n "$keep" "$marker" >"$tmp" && mv "$tmp" "$marker"
}
# fzf 行を生成。stack を file 行順 (line1=最新 undo コミット) で上から並べ、最後に
# 現在 HEAD 行 (最下) を出す。git log 風に「新しいコミットが上・現在地が下」。
# 各行: <lineno>\t<hash>\t<表示 '短縮hash  相対日時  件名'>。HEAD 行の lineno は
# センチネル 'HEAD' (選択時 no-op 判定に使う)。
build_rows() {
  local n i hash cur
  n=$(grep -c '.' "$marker")
  for ((i = 1; i <= n; i++)); do
    hash=$(sed -n "${i}p" "$marker")
    printf '%s\t%s\t%s\n' \
      "$i" "$hash" \
      "$(git log -1 --format='%h  %cr  %s' "$hash" 2>/dev/null || echo "$hash  (missing)")"
  done
  cur=$(git rev-parse HEAD)
  printf 'HEAD\t%s\t*  HEAD  %s\n' "$cur" "$(git log -1 --format='%h  %cr  %s' "$cur")"
}
# 選択した stack 行 (lineno) のコミット hash へ reset し、そこまで pop する。
# force=1 で divergence を無視。lineno より下 (新しい undo) は一緒に redo され消える。
restore_to() {
  local lineno="$1" hash="$2" force="$3"
  # 旧形式 (pre-stack) marker や壊れた行を踏むと git reset が失敗して詰まるので、
  # 先に実在コミットか検証する。
  if ! git rev-parse --verify --quiet "${hash}^{commit}" >/dev/null 2>&1; then
    die "==> Invalid stack entry: $hash. Stack file: $marker (remove it to reset)."
  fi
  # divergence: 現 HEAD が選択先の祖先 (= 前進 redo) なら安全。祖先でなければ巻き戻し
  # 後に新履歴ができており、reset は今の branch 上のコミットを捨ててしまう。
  # 判定は repo 単位 (branch 非考慮): marker は repo ごとに 1 本のため。
  if [[ $force -ne 1 ]] && ! git merge-base --is-ancestor HEAD "$hash"; then
    warn "==> Divergence detected: HEAD is not an ancestor of $hash."
    warn "    Restoring would drop the commits currently on the branch."
    warn "    To force restore, re-run with -f (or manually: git reset $hash)"
    die "==> Aborted. stack left intact."
  fi
  git reset "$hash"
  truncate_stack "$((lineno - 1))"
  info "==> Restored: git reset $hash"
  info "    Stack depth: $(stack_depth)"
}
# stack から redo 先を選んで restore する (grr / -r)。target 指定で非対話、無指定で fzf。
cmd_restore() {
  local force="$1" target="${2:-}" lineno hash rows sel
  [[ ! -s $marker ]] && die "==> No reset stack found. Cannot restore."

  # target 明示 (非対話・スクリプト用): その hash の stack 行を解決して restore。
  if [[ -n $target ]]; then
    lineno=$(grep -nxF "$target" "$marker" | tail -n1 | cut -d: -f1)
    [[ -z $lineno ]] && die "==> Not in the stack: $target"
    restore_to "$lineno" "$target" "$force"
    return
  fi

  # 無指定: fzf で stack + 現在 HEAD を見せて選ばせる。中断時は何もしない。
  # 行は先に確定して here-string で渡す (fzf が即 exit しても producer の SIGPIPE で
  # pipefail が誤発火しないように)。
  rows=$(build_rows)
  sel=$(fzf --ansi --reverse --height=80% --disabled \
    --delimiter=$'\t' --with-nth=3.. \
    --prompt='redo to> ' \
    --header='newest commit on top / * = current HEAD -- Enter: restore here  C-y: copy hash' \
    --preview 'git show --stat --color=always {2}' \
    --bind 'ctrl-y:execute-silent(printf %s {2} | clip)+abort' <<<"$rows") || return 0
  [[ -z $sel ]] && return 0
  lineno=$(cut -f1 <<<"$sel")
  hash=$(cut -f2 <<<"$sel")
  # HEAD 行を選んだら何もしない (既に現在地)。
  [[ $lineno == HEAD ]] && {
    info "==> Already at HEAD ($hash). Nothing to do."
    return 0
  }
  restore_to "$lineno" "$hash" "$force"
}
# reset 先のベース候補を fzf 行として組み立てる。候補は「各ブランチと HEAD の
# merge-base」= そのブランチから見た分岐点。git はブランチの派生元を記録しないので、
# 分岐点を計算で出すしかない (reflog の Created from は local 限定・期限切れするため
# 当てにしない)。
#   * refs/remotes/*/HEAD は短縮名が 'origin' になり origin/main 等と同じ分岐点で
#     重複するので除外する
#   * 件数 0 (= 分岐点が HEAD と同じ) は reset 先にならないので落とす
#   * 同じ分岐点に落ちるブランチは 1 行へまとめる (reset 先も件数も同一のため)。
#     名前は全部並べる: どのブランチ由来かが選ぶときの手掛かりになる
# 件数は --first-parent 基準。HEAD~N と同じ数え方なので stack の段数 (= grr で戻せる
# 回数) と一致する。merge を含んで総数と食い違うときだけ総数を併記する。総数の方が
# 「未コミットに戻る変更量」に近いが、段数と取り違えると grr の回数が合わなくなる。
# 各行: <分岐点 hash>\t<表示>
build_base_rows() {
  local cur full short base fp all disp bnames
  cur=$(git symbolic-ref -q --short HEAD || echo '')
  git for-each-ref --format='%(refname)%09%(refname:short)' refs/heads refs/remotes |
    while IFS=$'\t' read -r full short; do
      [[ $full == */HEAD ]] && continue
      [[ -z $short || $short == "$cur" || $short == removed/* ]] && continue
      base=$(git merge-base HEAD "$short" 2>/dev/null) || continue
      fp=$(git rev-list --count --first-parent "$base"..HEAD)
      [[ $fp -eq 0 ]] && continue
      all=$(git rev-list --count "$base"..HEAD)
      printf '%s\t%s\t%s\t%s\n' "$fp" "$all" "$base" "$short"
    done |
    sort -t$'\t' -k1,1n -k3,3 |
    awk -F'\t' '
      {
        if ($3 in names) { names[$3] = names[$3] ", " $4; next }
        names[$3] = $4; fp[$3] = $1; all[$3] = $2; ord[++c] = $3
      }
      END {
        for (i = 1; i <= c; i++) {
          k = ord[i]
          d = fp[k] " commit(s)"
          if (all[k] != fp[k]) d = d " (" all[k] " w/ merges)"
          if (length(d) > w) w = length(d)
          disp[i] = d
        }
        for (i = 1; i <= c; i++) {
          pad = ""
          for (j = length(disp[i]); j < w; j++) pad = pad " "
          printf "%s\t%s%s\t%s\n", ord[i], disp[i], pad, names[ord[i]]
        }
      }
    ' |
    while IFS=$'\t' read -r base disp bnames; do
      # git log は 1 行 1 プロセスなので、候補が集約で確定した後にだけ引く。
      printf '%s\t%s  %s  %s\n' "$base" "$disp" "$bnames" "$(git log -1 --format='%h  %cr  %s' "$base")"
    done
}
# 引数なし gre: reset 先のベースを fzf で選び、その hash を stdout に出す。
# 既定 layout は画面下から描くので、入力の 1 行目 (= 一番近い分岐点) がプロンプト直上
# = カーソル初期位置に来る。grr の --reverse とは意図的に逆。build_base_rows が既に
# 件数昇順で出しているので --tac は付けない (付けると上下が逆になる)。
# 中断時は空を返す。候補ゼロは fzf を開かず案内して終了する。
cmd_pick_base() {
  hass fzf
  local rows sel
  rows=$(build_base_rows)
  [[ -z $rows ]] &&
    die "==> No base branch candidates. Use '$command_name N' to undo N commit(s)."
  # SC2016: preview/bind は fzf 側で {1} を展開させるため単一引用で正しい。
  # shellcheck disable=SC2016
  sel=$(fzf --ansi --height=80% \
    --delimiter=$'\t' --with-nth=2.. \
    --prompt='reset to> ' \
    --header='nearest base at the bottom -- Enter: reset here  C-y: copy hash' \
    --preview 'git log --oneline --first-parent {1}..HEAD' \
    --bind 'ctrl-y:execute-silent(printf %s {1} | clip)+abort' <<<"$rows") || return 0
  [[ -z $sel ]] && return 0
  # 分岐点まで戻すと巻き戻す幅が大きい。作業ツリーが dirty だと既存の未コミット変更が
  # 同じ差分に混ざって読みにくくなる (mixed reset は作業ツリーを書き換えないので消えは
  # しない)。中断はせず警告だけ出す。件数指定は自分で幅を決めているので出さない。
  [[ -n $(git status --porcelain) ]] &&
    warn "==> Working tree is dirty. Existing changes will be mixed into the reset diff."
  cut -f1 <<<"$sel"
}
# push の reset 先 revision を決める。件数指定ならそれを検証して返し、無指定ならベース
# 選択の fzf にかける。中断時は空を返す (呼び出し側で no-op)。
resolve_push_target() {
  local count="$1"
  [[ -z $count ]] && {
    cmd_pick_base
    return
  }
  [[ $count =~ ^[1-9][0-9]*$ ]] ||
    die "==> Invalid count: $count (expected a positive integer)"
  # root commit や履歴不足では HEAD~count が無い。件数指定でしか起きないので、ここで
  # 件数入りのメッセージを出す (cmd_push の汎用 guard より読める)。
  git rev-parse --verify --quiet "HEAD~$count^{commit}" >/dev/null ||
    die "==> Cannot reset $count commit(s): HEAD~$count does not exist."
  echo "HEAD~$count"
}
# 指定した commit へ reset し、そこから HEAD までの first-parent commit を stack へ
# 1 個ずつ積む (gre N もベース選択も同じ経路)。後から grr で任意の 1 段だけ redo できる。
cmd_push() {
  local target="$1" resolved pushed
  # 実在しない revision で先へ進むと、途中まで reset した中途半端な状態と phantom stack
  # エントリが残る。先に解決して部分適用を防ぐ (count 経路は main 側で別途検証済み)。
  resolved=$(git rev-parse --verify --quiet "${target}^{commit}") ||
    die "==> Invalid reset target: $target"
  mkdir -p "$(dirname "$marker")"
  # prune: 現 HEAD が stack top の祖先でなければ、分岐して新規コミットした (or top が
  # GC 済) => 旧 redo チェーンは全部 dead。push 前に捨てて stack の肥大化を防ぐ。
  if [[ -s $marker ]]; then
    local top
    top=$(tail -n1 "$marker")
    if ! git merge-base --is-ancestor HEAD "$top" 2>/dev/null; then
      : >"$marker"
      warn "==> Stale redo stack cleared (HEAD diverged from top)."
    fi
  fi
  # --first-parent: HEAD~N と同じ辿り方。merge があっても 1 段 1 コミットで積む。
  # 出力は newest first なので、1 個ずつ reset して積んだのと同じ行順になる。
  pushed=$(git rev-list --first-parent "$resolved"..HEAD)
  [[ -z $pushed ]] && die "==> Nothing to reset: $target is already HEAD."
  printf '%s\n' "$pushed" >>"$marker"
  git reset "$resolved"
  warn "==> Executed: git reset $target"
  warn "    Stack depth: $(stack_depth)"
  warn "    Pushed (oldest first, newest last):"
  local h top body bl
  top=$(tail -n1 "$marker") # marker 末尾 = 今 reset したコミット
  while IFS= read -r h; do
    [[ -z $h ]] && continue
    warn "      $(git log -1 --format='%h  %cr  %s' "$h" 2>/dev/null || echo "$h  (missing)")"
  done <"$marker"
  # 末尾コミット (今 reset した分) だけ body も含め全文を、直前の subject 行に続けて出す。
  body=$(git log -1 --format='%b' "$top" 2>/dev/null)
  if [[ -n $body ]]; then
    while IFS= read -r bl; do
      warn "        $bl"
    done <<<"$body"
  fi
}
# 死んだ branch の stack marker を fzf で選んで trash する (-c)。marker の相対パス =
# branch 名。現存 branch (refs/heads) に無いものだけ候補に出す (現ブランチの生きた
# stack は掃除対象外)。prune-on-gre で内容は無害化済みだが、ファイルの片付け用。
cmd_clean() {
  hass fzf trash
  [[ ! -d $repo_stack_dir ]] && {
    info "==> No stacks for this repo. Nothing to clean."
    return 0
  }
  local rows='' f rel cnt sel
  while IFS= read -r f; do
    rel=${f#"$repo_stack_dir"/}
    git show-ref --verify --quiet "refs/heads/$rel" && continue # 生きてる branch は残す
    cnt=$(grep -c '.' "$f" 2>/dev/null || echo 0)
    rows+="$rel"$'\t'"$f"$'\t'"$cnt entries  $rel"$'\n'
  done < <(find "$repo_stack_dir" -type f)
  [[ -z $rows ]] && {
    info "==> No orphan stacks to clean."
    return 0
  }
  # SC2016: preview は fzf 側で {2}/$h を展開させるため単一引用で正しい。
  # shellcheck disable=SC2016
  sel=$(printf '%s' "$rows" | fzf --ansi --reverse --height=80% --multi \
    --delimiter=$'\t' --with-nth=3.. \
    --prompt='trash orphan stack> ' \
    --header='dead-branch stacks -- Tab: mark  Enter: trash selected' \
    --preview 'while read -r h; do git log -1 --format="%h  %cr  %s" "$h" 2>/dev/null || echo "$h  (missing)"; done <{2}') || return 0
  [[ -z $sel ]] && return 0
  while IFS=$'\t' read -r rel f _; do
    [[ -z $f ]] && continue
    trash "$f" && info "==> Trashed orphan stack: $rel"
  done <<<"$sel"
}
main() {
  set -eo pipefail
  git_root=$(git rev-parse --show-toplevel 2>/dev/null || :)
  [[ -z $git_root ]] && die "==> Not git repository"
  repo_dir_name=${git_root/\//}
  repo_dir_name=${repo_dir_name//\//-}
  # stack は branch 単位で分ける。detached HEAD は短縮 hash をキーにする。branch 名の
  # '/' (feature/x) はそのままサブディレクトリにする (sanitize せず bijective)。
  branch=$(git symbolic-ref -q --short HEAD || echo "DETACHED-$(git rev-parse --short HEAD)")
  config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/$command_name"
  # repo_stack_dir: この repo の全 branch stack を束ねる dir (-c の掃除対象範囲)。
  repo_stack_dir="$config_dir/$repo_dir_name"
  # stack: 1 行 1 ハッシュ。末尾が top (gre=append/push, grr=fzf で選んで redo/pop)。
  marker="$repo_stack_dir/$branch"

  # フラグはどの位置でもよい。非フラグ引数は mode 依存: restore なら復元先 hash
  # (無指定で fzf)、push なら undo する個数 (無指定でベース選択の fzf)。
  local mode=push force=0 target='' arg pick=''
  for arg in "$@"; do
    case "$arg" in
      -r) mode=restore ;;
      -c) mode=clean ;;
      -v) mode=viewmarker ;;
      -f) force=1 ;;
      -*) die "==> Unknown option: $arg" ;;
      # 非フラグ引数は 1 個だけ。後勝ち上書きだと `gre abc 3` の typo が黙って
      # 3 commit の undo になるため、2 個目を見つけた時点で止める。
      *)
        [[ -n $target ]] && die "==> Unexpected extra argument: $arg (already got: $target)"
        target="$arg"
        ;;
    esac
  done

  case "$mode" in
    restore) cmd_restore "$force" "$target" ;;
    clean) cmd_clean ;;
    viewmarker) echo "$marker" | v ;;
    push)
      pick=$(resolve_push_target "$target")
      [[ -z $pick ]] && return 0
      cmd_push "$pick"
      ;;
  esac
}
main "$@"
