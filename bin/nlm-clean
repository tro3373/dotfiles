#!/usr/bin/env bash

readonly notebook_url=https://notebooklm.google.com/notebook

usage() {
  cat <<EOF
Usage: nlm-clean [-z]

  Select NotebookLM notebooks with fzf (multi select) and delete them.

  Options:
    -z, -0, --zero  Only list notebooks having no sources
    -h, --help      Show this usage

  Keys:
    ctrl-l  Toggle all
    ctrl-g  Toggle preview of sources (hidden by default, takes a few seconds)
    ctrl-o  Open the notebook under the cursor in browser
    ctrl-y  Copy the line under the cursor
EOF
}

parse_args() {
  for arg in "$@"; do
    case "${arg}" in
      -z | -0 | --zero) zero_only=true ;;
      -h | --help)
        usage
        exit 0
        ;;
      *)
        echo "==> Error: Unknown option: ${arg}" >&2
        usage >&2
        exit 2
        ;;
    esac
  done
}

# nlm notebook list --all の TSV(ID/TITLE/SOURCES/LAST UPDATED)を
# ID/SOURCES/LAST UPDATED/TITLE の順に並べ替えて桁揃えする。
# 長いタイトルを末尾に送り、SOURCES を画面左に残す
list_notebooks() {
  local awk_filter='1'
  if [[ ${zero_only} == true ]]; then
    # shellcheck disable=SC2016 # $3 は awk のフィールド参照。展開させない
    awk_filter='NR == 1 || $3 == 0'
  fi
  # shellcheck disable=SC2016 # $1 等は awk のフィールド参照。展開させない
  nlm notebook list --all |
    awk -F'\t' -v OFS='\t' "${awk_filter}"' { print $1, $3, $4, $2 }' |
    column -t -s $'\t'
}

select_notebooks() {
  selected=$(
    printf '%s\n' "${rows}" |
      fzf -m \
        --header-lines=1 \
        --preview 'nlm source list {1}' \
        --preview-window=hidden,down,border-top,60% \
        --exit-0 \
        --bind 'ctrl-l:toggle-all,ctrl-g:toggle-preview,ctrl-y:execute-silent(echo {} |clip)+abort' \
        --bind "ctrl-o:execute-silent(open ${notebook_url}/{1})"
  )
}

confirm_delete() {
  echo "==> Deleting $(printf '%s\n' "${selected}" | wc -l) notebook(s):" | ink yellow
  printf '%s\n' "${selected}" >&2

  local answer=
  read -r -p "==> Are you sure? [y/N] " answer
  [[ ${answer} =~ ^[Yy] ]] && return 0

  echo "==> Canceled" >&2
  return 1
}

delete_one() {
  echo "==> Deleting ${id} ${rest}" | ink yellow
  # -y: パイプ経由だと nlm が端末を持たず確認できずに中止するため必須
  nlm notebook delete -y "${id}" </dev/null || echo "==> Error: Failed to delete ${id}" >&2
}

delete_notebooks() {
  local id rest
  while read -r id rest; do
    [[ -z ${id} ]] && continue
    delete_one
  done <<<"${selected}"
}

main() {
  set -euo pipefail
  needs nlm fzf column awk open

  local zero_only=false
  parse_args "$@"

  local rows
  rows=$(list_notebooks)
  if [[ $(printf '%s\n' "${rows}" | wc -l) -le 1 ]]; then
    echo "==> No notebook found" >&2
    return
  fi

  local selected
  select_notebooks || return 0
  [[ -z ${selected} ]] && return 0

  confirm_delete || return 0
  delete_notebooks
}
main "$@"
