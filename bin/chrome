#!/usr/bin/env bash

# CHROME_PROFILE で開く Chrome プロファイルを選ぶ。
# 値はプロファイルにログイン中の Google アカウント (メールアドレス) の前方一致。
# repo 毎に変えるなら .envrc に `export CHROME_PROFILE=<mail>` を置く (direnv)。
# 未設定・解決できない値なら Chrome が最後に使ったプロファイルで開く。

entries=("/Applications/Google Chrome.app/Contents/MacOS/Google Chrome")
has() { command -v "${1}" >&/dev/null; }

bin_path() {
  for arg in google-chrome-stable google-chrome chromium-browser chromium; do
    has "${arg}" && echo "$arg" && return
  done
  for arg in "${entries[@]}"; do
    if [[ -e ${arg} ]]; then
      echo "${arg}"
      return
    fi
  done
}

# 実在しない値を渡すと Chrome が同名のプロファイルを新規作成してしまうので、
# 解決できなければ何も返さない (呼び出し元がプロファイル指定なしで開く)。
profile_dir() {
  [[ -z $1 ]] && return
  chrome-profile "$1" 2>/dev/null || true
}

main() {
  set -eo pipefail
  _bin="$(bin_path)"
  [[ -z $_bin ]] && elog "==> No Chrome binary found"
  local args=()
  _profile=$(profile_dir "${CHROME_PROFILE:-}")
  [[ $_profile == *$'\n'* ]] &&
    elog "==> Multiple chrome profiles match: $CHROME_PROFILE (${_profile//$'\n'/, })"
  [[ -n $_profile ]] && args+=("--profile-directory=$_profile")
  [[ -n ${CHROME_PROFILE:-} && -z $_profile ]] &&
    echo "==> No chrome profile signed in as: $CHROME_PROFILE" >&2
  set -x
  exec "$_bin" "${args[@]}" "$@" >&/dev/null &
}
main "$@"
