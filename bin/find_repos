#!/usr/bin/env bash

command_name=$(basename "$0") && readonly command_name
find_root_dirs=("$HOME"/src)
find_entries() {
  # git repository を探す
  for d in "${find_root_dirs[@]}"; do
    [[ ! -d $d ]] && continue
    find "$d/" -maxdepth 4 -type d -name '.git' 2>/dev/null |
      sed 's|/.git$||'
  done
}

sources() {
  {
    echo "$HOME/.dot"
    echo "$HOME/.mo"
    find_entries
    ghq list --full-path
  } 2>/dev/null
}

first_per_realpath() {
  local -a dirs reals
  local -A seen=()
  local i
  mapfile -t dirs
  if [[ ${#dirs[@]} -eq 0 ]]; then
    return
  fi
  mapfile -t reals < <(realpath -m -- "${dirs[@]}")
  for i in "${!dirs[@]}"; do
    [[ -n ${seen[${reals[i]}]:-} ]] && continue
    seen[${reals[i]}]=1
    printf '%s\n' "${dirs[i]}"
  done
}

usage() {
  cat <<EOF
List git repository dirs, oldest mtime first.

  Usage:
      ${command_name} [--main]

  Options:
      --main : one dir per repo. A worktree is folded into its main checkout,
               and a dir that is not a git repo is dropped
EOF
}

main_checkout_of() {
  local common
  common=$(git -C "${dir}" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 0
  common=$(realpath -m -- "${common}")
  if [[ ${common} == */.git ]]; then
    printf '%s\n' "${common%/.git}"
    return
  fi
  printf '%s\n' "${dir}"
}

fold_to_main_checkout() {
  local dir
  while IFS= read -r dir; do
    main_checkout_of
  done | first_per_realpath
}

main() {
  set -eo pipefail
  local fold=cat
  case "${1:-}" in
    -h | --help)
      usage
      return
      ;;
    --main) fold=fold_to_main_checkout ;;
    "") ;;
    *)
      usage >&2
      return 2
      ;;
  esac
  sources |
    first_per_realpath |
    "${fold}" |
    while IFS= read -r dir; do
      [[ ! -d $dir ]] && continue
      printf '%s\t%s\n' "$(stat -c %Y "$dir" 2>/dev/null || echo 0)" "$dir"
    done |
    sort -n |
    cut -f2-
}
main "$@"
