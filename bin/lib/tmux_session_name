#!/usr/bin/env bash
# tmux セッション名の生成規則 (SSOT)。bin/tasks と bin/cd-src-root が source する。
#
# ディレクトリ 1 つから名前を決める。同じディレクトリなら、どの入口から起動しても
# 同じ名前になる (= 1 つの worktree に 2 セッションできない) ことが目的。
#   - 通常のリポジトリ : <ディレクトリ名>
#   - worktree         : <repo>-<ブランチ名>
#   - git 管理外       : <ディレクトリ名>
#
# worktree かどうかと repo 名は、置き場所の決まり (lib/worktree_path) から読み取る。
# 自分のディレクトリ名がそのままブランチ名 ('/' は '-' 済み) になる。git に問い合わせずに
# 決まるので、候補一覧 (数百件) に対して回しても速い。
#
# tmux のセッション名は '.' や ':' を含められないので、英数 '_' '-' 以外を '-' に
# 置換し、先頭の '-' を落とす。

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  echo "==> Source this file instead of running it: $0" >&2
  exit 1
fi

# shellcheck disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/worktree_path"

tmux_session_name() {
  local dir=${1%/} name repo
  name=${dir##*/}
  worktree_repo_name "$dir" repo && name="${repo}-${name}"
  name=${name//[^A-Za-z0-9_-]/-}
  printf '%s\n' "${name#-}"
}
