#!/usr/bin/env bash
# task2 の index.md (repo ごとの一覧と人の書く欄) を引き、人の書く欄 (末尾) へ追記する。

# cwd の repo の index.md の絶対パスを出す。ファイルがあるとは限らない。
task2_index_path() {
  task2 where | jq -er '.index'
}

# dir で見せるべき task2 のファイルを出す。
# ブランチのタスクがあればその task.md、無ければ repo の index.md。
# main checkout は普通タスクを持たないので、index.md へ落とさないと何も出ない。
task2_doc_path() {
  local dir=$1
  task2 current -C "${dir}" --path 2>/dev/null && return 0
  (cd "${dir}" && task2_index_path 2>/dev/null)
}

# stdin を index.md の末尾へ足す。
# task2 は一覧を作り直すとき index.md を rename で置き換えるので、
# 同じディレクトリの flock を取らずに書くと、作り直しと重なった分が消える。
# 中身は lock の外で読み切る。読む間 (fzf・API) ずっと lock を握らない。
task2_index_append() {
  local index=$1 body
  body=$(cat)
  [[ -n ${body} ]] || return 0
  (
    flock -x 9
    printf '%s\n' "${body}" >>"${index}"
  ) 9<"$(dirname "${index}")"
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  echo "${0##*/}: source only" >&2
  exit 1
fi
