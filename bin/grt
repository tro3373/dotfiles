#!/usr/bin/env bash

main() {
  set -eo pipefail
  local dst
  if ! dst=$(task2 where | jq -er '.index'); then
    elog "==> Error: Failed to find the task2 index.md of this repository."
    exit 1
  fi
  if [[ ! -e $dst ]]; then
    elog "==> Error: $dst not found. Add a task with task2 add first."
    exit 1
  fi
  gtasks_to_tasks "$@" >>"$dst"
  echo "$dst" | v
}
main "$@"
