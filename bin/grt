#!/usr/bin/env bash

# shellcheck disable=SC1091
source "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/lib/task2_index"

main() {
  set -eo pipefail
  local dst
  dst=$(task2_index_path) || exit 1
  local body
  body=$(gtasks_to_tasks "$@")
  task2_index_append "$dst" <<<"$body"
  echo "$dst" | v
}
main "$@"
