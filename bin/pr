#!/usr/bin/env bash

command_name=$(basename "$0") && readonly command_name
script_dir=$(cd "$(dirname "$0")" && pwd) && readonly script_dir
readonly depends=(gh curl fzf jq llm)
# 派生元の候補が同じ近さで並んだときに優先するブランチ (前ほど優先)
readonly integration_branches=(develop main master)
issues=
title=
body=
target_tmp_dir=
own_tmp_dir=0
target_branch=
head_branch=
head_ref=HEAD
current_branch=
compact=0
base_only=0

usage() {
  cat <<EOF

Make a pull request via llm from commit messages and diff stat.

  Usage:
      $command_name [option] [base_branch]
      $command_name [option] <head_branch> <base_branch>
    Options
      -h|--help     : Show this usage
      -i|--issue    : Issue number to link with the PR
      -t|--title "" : Specify title directly
      -b|--body ""  : Specify body directly
      -d|--dir      : Specify target_tmp_dir that has title/body
      -c|--compact  : Compact mode
      --base        : Print the base branch and exit

    Base branch
      [base_branch] > \$PR_TARGET_BRANCH > the nearest fork point on origin.
      With a tty, pick one of origin's branches by fzf (nearest at the bottom).

    Head branch
      Omitted: push the current branch and open the PR from it.
      Given: open the PR from origin/<head_branch> as it is, without checkout or push.
        e.g. $command_name -c develop staging-kyotanabe

EOF
}

has() { command -v "${1}" >&/dev/null; }
hass() { for _arg in "$@"; do has "$_arg" || die "==> No $_arg command exist."; done; }
_ink() { if has ink; then ink "$@"; else cat - 1>&2; fi; }
#_log() { echo "$(date +"%Y-%m-%d %H:%M:%S") $(test ! -t 0 && cat -) ${@:2}" | _ink "$1"; }
# shellcheck disable=SC2145
_log() { echo "$(date +"%Y-%m-%d %H:%M:%S") ${@:2}" | _ink "$1"; }
log() { _log white "$*"; }
info() { _log cyan "$*"; }
warn() { _log yellow "$*"; }
die() { _log red "$*" && exit 1; }
check() {
  hass "${depends[@]}"
  # -c は自分で parts を作る。-d の用意済み parts を上書きしてしまう
  if [[ -n $target_tmp_dir && $compact -eq 1 ]]; then
    die "==> -c and -d cannot be used together."
  fi
  # -d は title/body を外部で用意して渡すモード。無いまま進むと空の PR ができる
  if [[ -n $target_tmp_dir ]]; then
    for f in title body; do
      [[ -s "$target_tmp_dir/$f" ]] || die "==> $target_tmp_dir/$f not found or empty."
    done
  fi
}
initialize() {
  local positionals=()
  while true; do
    [[ -z $1 ]] && break
    case "$1" in
      -h | --help) usage && exit 0 ;;
      # -e) dummy= ;;
      # -f*|--file*) file=${1#*=} ;;
      # -f|--file) shift && file=$1 ;;
      -i | --issue) shift && issues="$1" ;;
      -t | --title) shift && title="$1" ;;
      -b | --body) shift && body="$1" ;;
      -d | --dir) shift && target_tmp_dir=$1 ;;
      -c | --compact) compact=1 ;;
      --base) base_only=1 ;;
      *) positionals+=("$1") ;;
    esac
    shift
  done
  case ${#positionals[@]} in
    0) ;;
    1) target_branch=${positionals[0]} ;;
    2) head_branch=${positionals[0]} target_branch=${positionals[1]} ;;
    *) usage && die "==> Too many branches: ${positionals[*]}" ;;
  esac
  check
  trap end EXIT
  set -eo pipefail
  # web_url=$(create_pr_with_push) の中で gh pr create が落ちても止まるように
  shopt -s inherit_errexit
  current_branch=$(git rev-parse --abbrev-ref HEAD)
}

# head を指定したらローカルのブランチは使わない。
# ローカルが古いまま PR の本文を作らないよう、origin の最新どうしで比べる
use_head_branch() {
  [[ -z $head_branch ]] && return
  info "==> Git fetching.."
  git fetch origin 1>&2
  current_branch=${head_branch#origin/}
  head_ref=origin/$current_branch
  target_branch=origin/${target_branch#origin/}
}

find_target_branch_with_fetch() {
  [[ -n $PR_TARGET_BRANCH ]] && echo "$PR_TARGET_BRANCH" && return
  local only=()
  if [[ $current_branch =~ ^(main|master)$ ]]; then
    die "==> Current branch is $current_branch. Please checkout to other branch."
  fi
  if [[ $current_branch == "develop" ]]; then
    # develop から切った feature も分岐点が近く見えるので、main/master に絞る
    only=(main master)
    confirm_push_to_develop
  fi

  # Fetch the latest changes from the remote repository
  info "==> Git fetching.."
  git fetch origin 1>&2

  info "==> Finding target branch.."
  pick_target_branch "${only[@]}"
}

confirm_push_to_develop() {
  # --base は push しないので確認は要らない
  [[ $base_only -eq 1 ]] && return
  warn "==> Current branch is $current_branch. Local changes will be pushed to $current_branch."
  if [[ ! -t 0 ]]; then
    die "==> Not a tty. Pass the base branch explicitly instead of confirming."
  fi
  warn "==> Press Enter to continue..(Cancel: Ctrl+C)"
  read -r _
}

# origin の派生元候補を近い順に出す。引数があればそのブランチだけに絞る。
# 各行: <件数>\t<優先順位>\t<origin/branch>\t<表示>
list_base_candidates() {
  local only=("$@") fp branch name rank i
  "$script_dir"/git_base_candidates -r origin |
    while IFS=$'\t' read -r fp _ _ branch; do
      name=${branch#origin/}
      [[ $name == "$current_branch" ]] && continue
      [[ ${#only[@]} -gt 0 && " ${only[*]} " != *" $name "* ]] && continue
      rank=${#integration_branches[@]}
      for i in "${!integration_branches[@]}"; do
        [[ ${integration_branches[$i]} == "$name" ]] && rank=$i
      done
      printf '%s\t%s\t%s\t%s  %s commit(s)\n' "$fp" "$rank" "$branch" "$branch" "$fp"
    done |
    sort -t$'\t' -k1,1n -k2,2n -k3,3
}

# 分岐点だけでは「親」と「自分から切られた子」を見分けられない。
# tty があれば fzf で選ばせ、無ければ一番近いものを採る。
pick_target_branch() {
  local rows
  rows=$(list_base_candidates "$@")
  [[ -z $rows ]] && return
  if [[ $base_only -eq 1 || ! -t 0 ]]; then
    head -1 <<<"$rows" | cut -f3
    return
  fi
  # SC2016: preview は fzf 側で {3} を展開させるため単一引用で正しい。
  # shellcheck disable=SC2016
  fzf --height=40% --select-1 \
    --delimiter=$'\t' --with-nth=4 \
    --prompt='base> ' \
    --header='nearest base at the bottom' \
    --preview 'git log --oneline --first-parent "$(git merge-base HEAD {3})"..HEAD' <<<"$rows" |
    cut -f3
}

cat_issue() {
  cat <<EOF

## 関連Issue

$(echo "$issues" | tr ',' '\n' | sed -e 's/^/- #/')

EOF
}

cat_commit_list() {
  cat <<EOF

## コミット一覧

$(sed -e 's/^/- /' "$target_tmp_dir"/commit_list)

EOF
}

cat_prompt_input() {
  cat <<EOF

### Commit messages

$(cat <"$target_tmp_dir"/commit_messages)

### Diff stat

$(cat <"$target_tmp_dir"/diff_stat)
EOF
}

create_commit_messages() {
  info "==> Creating commit_messages.."
  git log --format='#### %s%n%n%b' "$target_branch".."$head_ref" >"$target_tmp_dir"/commit_messages
}

create_diff_stat() {
  info "==> Creating diff_stat.."
  git_diff_ignored --stat "$target_branch"..."$head_ref" >"$target_tmp_dir"/diff_stat
}

create_commit_list() {
  info "==> Creating commit_list.."
  git log --oneline "$target_branch".."$head_ref" >"$target_tmp_dir"/commit_list
}

create_pr_parts() {
  if [[ -n $title && -n $body ]]; then
    echo "$title" >"$target_tmp_dir"/title
    echo "$body" >"$target_tmp_dir"/body
    return
  fi

  create_diff_stat
  create_commit_messages
  create_commit_list

  if [[ ! -s $target_tmp_dir/diff_stat ]]; then
    warn "No changes"
    exit 0
  fi

  # diff 本体は渡さない。大きい PR だと groq の入力上限を超えて落ちる。
  # why はコミット body にあるので、要約の材料はコミットと stat で足りる
  info "==> Creating messages.json.."
  cat_prompt_input |
    prp -ne gen-git-pr-message.md$ >"$target_tmp_dir"/prompt.md
  cat <"$target_tmp_dir"/prompt.md |
    llm -p groq >"$target_tmp_dir"/messages.json

  info "==> Creating title/body.."
  jq -r '.title' "$target_tmp_dir"/messages.json >/dev/null 2>&1 || {
    cat <"$target_tmp_dir"/messages.json |
      sed -e '/^```/d' -e '/```json/d' -e '/^$/d' >"$target_tmp_dir"/messages.json.bk
    mv "$target_tmp_dir"/messages.json.bk "$target_tmp_dir"/messages.json
  }
  jq -r '.title' "$target_tmp_dir"/messages.json >"$target_tmp_dir"/title
  jq -r '.body' "$target_tmp_dir"/messages.json >"$target_tmp_dir"/body
  if [[ -n $issues ]]; then
    cat_issue >>"$target_tmp_dir"/body
  fi
  cat_commit_list >>"$target_tmp_dir"/body
}

create_compact_pr_parts() {
  echo "Merge $current_branch to ${target_branch#origin/}" >"$target_tmp_dir"/title
  create_commit_list
  cat_commit_list >"$target_tmp_dir"/body
}

create_pr_with_push() {
  push_current_branch
  _target_branch=${target_branch#origin/}
  is_origin_is_gitlab && {
    dump_pr_or_mr MR
    create_mr
    return
  }
  dump_pr_or_mr PR
  create_pr
}

push_current_branch() {
  [[ -n $head_branch ]] && return
  info "==> Pushing commits.."
  git push -u origin "$current_branch" 1>&2
}

is_origin_is_gitlab() { git remote get-url origin 2>/dev/null | grep -q gitlab; }
dump_pr_or_mr() {
  info "==> Creating $1!.."
  # shellcheck disable=SC2016
  cat <<EOF | ink yellow
branch: $current_branch ==> $_target_branch
 title: $(cat <"$target_tmp_dir"/title)
  body:
$(cat <"$target_tmp_dir"/body | sed 's/"/\\"/g; s/`/\\`/g')
EOF
}

create_pr() {
  # Make PR
  cat <"$target_tmp_dir"/body |
    gh pr create \
      --base "$_target_branch" \
      --head "$current_branch" \
      --title "$(cat <"$target_tmp_dir"/title)" \
      --body-file - 1>&2
  # Mark PR as ready
  # --draft
  # gh pr ready 1>&2
  gh pr view "$current_branch" --json url --jq '.url'
}

create_mr() {
  # --draft
  glab mr create \
    --target-branch "$_target_branch" \
    --source-branch "$current_branch" \
    --title "$(cat <"$target_tmp_dir"/title)" \
    --description "$(cat <"$target_tmp_dir"/body)" 1>&2
  glab mr view "$current_branch" --json webUrl --jq '.webUrl'
}

# 自分で作った parts は成功したら消す。失敗したら -d で打ち直せるよう残す
end() {
  local rc=$?
  [[ $own_tmp_dir -eq 1 && $rc -eq 0 ]] && rm -rf "$target_tmp_dir"
  [[ $own_tmp_dir -eq 1 && $rc -ne 0 && -s $target_tmp_dir/title ]] &&
    warn "==> Parts kept. Retry: $command_name -d $target_tmp_dir $head_branch $target_branch"
  [[ $rc -eq 0 ]] && info "==> Done!"
  return $rc
}

create_own_pr_parts() {
  target_tmp_dir=$(mktemp -d -t pr.XXXXXX)
  own_tmp_dir=1
  local create=create_pr_parts
  [[ $compact -eq 1 ]] && create=create_compact_pr_parts
  $create
}

main() {
  initialize "$@"
  use_head_branch

  if [[ -z $target_branch ]]; then
    target_branch=$(find_target_branch_with_fetch)
    if [[ -z $target_branch ]]; then
      die "==> No target branch found."
    fi
  fi
  info "==> Target branch: $target_branch"
  [[ $base_only -eq 1 ]] && echo "$target_branch" && return

  [[ -z $target_tmp_dir ]] && create_own_pr_parts
  web_url=$(create_pr_with_push)
  info "==> PR created successfully! see: $web_url"
  open "$web_url"
}
main "$@"
