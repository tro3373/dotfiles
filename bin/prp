#!/usr/bin/env -S bash -e

command_name=$(basename "$0") && readonly command_name
pre_message=
edit=1

fire() {
  find "$HOME"/.mo/prompt/ -type f -name '*.md'
}

usage() {
  cat <<EOF
Usage: $command_name [OPTION] [fuzzy query for filter prompts]

Options:
  -h, --help  Display this help and exit
  -ne         No Edit. Cat only
  -pm         Set pre-message for the prompt

EOF
}

initialize() {
  while true; do
    [[ -z $1 ]] && break
    case "$1" in
      -h | --help) usage && exit 0 ;;
      -ne) edit=0 ;;
      -pm) shift && pre_message="$1" ;;
      *) add_args "$1" ;;
    esac
    shift
  done
}
add_args() { args+=("$@"); }
cleanup() { rm -rf "${tmp_dir:-}"; }
main() {
  initialize "$@"
  set -euo pipefail
  local f
  f=$(
    fire |
      fzf --preview 'bat --color=always --style=header,grid --line-range :500 {}' \
        --query "${args[*]}" \
        --select-1 --exit-0
  )
  [[ -z $f ]] && return 0

  # ディレクトリにするのは、nvim の filetype 用に名前を .md で終えるため。
  trap cleanup EXIT
  tmp_dir=$(mktemp -d -t "$command_name".XXXXXX)
  local dst="$tmp_dir"/prompt.md
  {
    [[ -n $pre_message ]] && echo "$pre_message"
    cat <"$f"
  } >"$dst"
  if [[ ! -t 0 ]]; then
    cat <&0 >>"$dst"
  fi

  [[ $edit -ne 1 ]] && {
    cat "$dst"
    return 0
  }
  nvim "$dst"
}
main "$@"
