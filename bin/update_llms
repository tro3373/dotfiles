#!/usr/bin/env bash

cmds=(
  'claude update'
  'claude plugin marketplace update'
  # -s user: some plugins are also installed at project scope, and auto-detect follows cwd.
  'claude plugin update -s user codex@openai-codex'
  'claude plugin update -s user eli5@claude-community'
  'claude plugin update -s user html-plan@claude-community'
  'claude plugin update -s user example-skills@anthropic-agent-skills'
  'claude plugin update -s user mattpocock-skills@claude-plugins-official'
  'claude plugin update -s user security-guidance@claude-plugins-official'
  'claude plugin update -s user stripe@claude-plugins-official'
  'claude plugin update -s user gopls-lsp@claude-plugins-official'
  'claude plugin update -s user jdtls-lsp@claude-plugins-official'
  'claude plugin update -s user kotlin-lsp@claude-plugins-official'
  'claude plugin update -s user lua-lsp@claude-plugins-official'
  'claude plugin update -s user pyright-lsp@claude-plugins-official'
  'claude plugin update -s user rust-analyzer-lsp@claude-plugins-official'
  'claude plugin update -s user typescript-lsp@claude-plugins-official'
)

has() { command -v "${1}" >&/dev/null; }
hass() { for _arg in "$@"; do has "$_arg" || die "==> No $_arg command exist."; done; }
_ink() { if has ink; then ink "$@"; else cat - 1>&2; fi; }
#_log() { echo "$(date +"%Y-%m-%d %H:%M:%S") $(test ! -t 0 && cat -) ${@:2}" | _ink "$1"; }
# shellcheck disable=SC2145
_log() { echo "$(date +"%Y-%m-%d %H:%M:%S") ${@:2}" | _ink "$1"; }
log() { _log white "$*"; }
info() { _log cyan "$*"; }
warn() { _log yellow "$*"; }
die() { _log red "$*" && exit 1; }

kick() {
  cmd="$(echo "$update_cmd" | awk '{print $1}')"
  has "$cmd" || {
    warn "==> No $cmd command exist, skip update."
    return 0
  }
  info "=> $update_cmd .."
  $update_cmd
  info "=> $update_cmd Done!"
}

main() {
  set -eo pipefail
  for update_cmd in "${cmds[@]}"; do
    kick
  done
}
main "$@"
