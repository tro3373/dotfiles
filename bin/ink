#!/usr/bin/env bash

readonly colors=(black red green yellow blue purple cyan gray white)

color_code() {
  case $1 in
    black) echo "0;30m" ;;
    red) echo "1;31m" ;;
    green) echo "1;32m" ;;
    yellow) echo "1;33m" ;;
    blue) echo "1;34m" ;;
    purple) echo "1;35m" ;;
    cyan) echo "1;36m" ;;
    gray) echo "0;37m" ;;
    white) echo "0m" ;;
    *) return 1 ;;
  esac
}

_ink() {
  local stdin=
  if [[ ! -t 0 ]]; then
    stdin="$(cat <&0)"
  fi
  if [[ $# -eq 0 && -z $stdin ]]; then
    return
  fi

  local esc=$'\033'
  local reset="${esc}[0m"
  local text="$stdin$*"
  local color="${reset}"
  local code
  if code=$(color_code "${1:-}"); then
    color="${esc}[${code}"
    text="$stdin${*:2}"
  fi

  printf "%s%s%s\n" "${color}" "${text}" "${reset}" 1>&2
}

main() {
  if [[ $# -eq 0 ]]; then
    local col
    for col in "${colors[@]}"; do
      echo "${col}" | _ink "${col}"
    done
    return
  fi
  _ink "$@"
}
main "$@"
