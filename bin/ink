#!/usr/bin/env bash

readonly colors=(black red green yellow blue purple cyan gray white)

_ink() {
  local stdin=
  if [[ ! -t 0 ]]; then
    stdin="$(cat <&0)"
  fi
  if [[ $# -eq 0 && -z $stdin ]]; then
    return
  fi

  local esc=$'\033'
  local reset="${esc}[0m"
  local -A codes=(
    [black]="${esc}[0;30m"
    [red]="${esc}[1;31m"
    [green]="${esc}[1;32m"
    [yellow]="${esc}[1;33m"
    [blue]="${esc}[1;34m"
    [purple]="${esc}[1;35m"
    [cyan]="${esc}[1;36m"
    [gray]="${esc}[0;37m"
    [white]="${reset}"
  )

  local text="$stdin$*"
  local color="${reset}"
  if [[ -n ${codes[${1:-}]:-} ]]; then
    color="${codes[$1]}"
    text="$stdin${*:2}"
  fi

  printf "%s%s%s\n" "${color}" "${text}" "${reset}" 1>&2
}

main() {
  if [[ $# -eq 0 ]]; then
    local col
    for col in "${colors[@]}"; do
      echo "${col}" | _ink "${col}"
    done
    return
  fi
  _ink "$@"
}
main "$@"
