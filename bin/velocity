#!/usr/bin/env bash

script_dir=$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd) && readonly script_dir
command_name=$(basename "$0") && readonly command_name
readonly day=86400
readonly span_days=30

usage() {
  cat <<EOF
Show my commit / merge / pr counts per repo for the last 1d, 7d and 30d.

  Usage:
      ${command_name}

  Counts:
      commit : my non-merge commits on all branches, by author date
      merge  : my merge commits on the default branch (--first-parent)
      pr     : my merged PRs on github.com, for every logged-in gh account

  Env:
      VELOCITY_NOW : epoch seconds used as "now" (default: current time)
EOF
}

# Prints "<group>\x1f<repo>" for a repo dir. <repo> is empty for a group of one repo.
location_of() {
  local dir="$1" rel
  case "${dir}" in
    "${ghq_root}"/*)
      rel=${dir#"${ghq_root}"/}
      rel=${rel#*/}
      printf 'ghq/%s\x1f%s\n' "${rel%%/*}" "${rel#*/}"
      return
      ;;
    "${HOME}"/.*)
      rel=${dir#"${HOME}"/}
      # shellcheck disable=SC2088 # "~" is a label here, not a path to expand
      printf '%s\x1f\n' "~/${rel%%/*}"
      return
      ;;
    "${HOME}"/*) rel=${dir#"${HOME}"/} ;;
    *)
      printf '%s\x1f\n' "${dir}"
      return
      ;;
  esac
  local group
  group=$(cut -d/ -f1-2 <<<"${rel}")
  local name=${rel#"${group}"}
  printf '%s\x1f%s\n' "${group}" "${name#/}"
}

# Prints owner/name when the origin is on github (ssh host aliases included).
github_slug_of() {
  local url
  url=$(git -C "$1" remote get-url origin 2>/dev/null) || return 0
  [[ ! ${url} =~ github[^:/]*[:/]([^/]+)/([^/]+)$ ]] && return 0
  printf '%s/%s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]%.git}"
}

# Prints the local and origin refs of the default branch: origin/HEAD's target, else main, else master.
default_refs() {
  local name
  name=$(git -C "$1" symbolic-ref -q --short refs/remotes/origin/HEAD) || name=
  name=${name#origin/}
  if [[ -z ${name} ]]; then
    name=$(git -C "$1" for-each-ref --count=1 --format='%(refname:lstrip=2)' refs/heads/main refs/heads/master)
  fi
  [[ -z ${name} ]] && return 0
  git -C "$1" for-each-ref --format='%(refname)' "refs/heads/${name}" "refs/remotes/origin/${name}"
}

# Event lines: "<metric>\t<epoch>\t<group>\t<repo>\t<dedupe key>"
repo_events() {
  local email
  email=$(git -C "${dir}" config user.email) || return 0
  local since=$((now - span_days * day))
  git -C "${dir}" log --exclude=refs/stash --exclude='refs/notes/*' --all --no-merges --format='%at%x09%ae%x09%s' |
    awk -F'\t' -v OFS='\t' -v me="${email}" -v since="${since}" -v group="${group}" -v repo="${repo}" \
      '$2 == me && $1 > since { print "commit", $1, group, repo, $1 " " $3 }'
  local -a refs
  mapfile -t refs < <(default_refs "${dir}")
  [[ ${#refs[@]} -eq 0 ]] && return 0
  git -C "${dir}" log --first-parent --merges --since="@${since}" --format='%at%x09%ae%x09%H' "${refs[@]}" |
    awk -F'\t' -v OFS='\t' -v me="${email}" -v group="${group}" -v repo="${repo}" \
      '$2 == me { print "merge", $1, group, repo, $3 }'
}

# Lines: "<dir>\x1f<group>\x1f<repo>\x1f<github slug>"
# \x1f keeps an empty <repo> as its own field under `read`, which a tab would not.
# A worktree takes the row of its main checkout.
# Clones of one github repo share one row. The row is the clone under ~/, then the clone
# whose dir name is the repo name, then the first clone listed.
list_repos() {
  local dir
  "${script_dir}/find_repos" --main | while IFS= read -r dir; do
    printf '%s\x1f%s\x1f%s\n' "${dir}" "$(location_of "${dir}")" "$(github_slug_of "${dir}")"
  done | awk -F'\037' -v OFS='\037' '
    function score(   base) {
      base = $1
      sub(/.*\//, "", base)
      return ($2 ~ /^~\//) * 2 + (base == substr($4, index($4, "/") + 1))
    }
    { line[++n] = $0 }
    $4 != "" && (!($4 in best) || score() > best[$4]) { best[$4] = score(); row[$4] = $2 OFS $3 }
    END {
      for (i = 1; i <= n; i++) {
        $0 = line[i]
        if ($4 in row) { split(row[$4], r, OFS); $2 = r[1]; $3 = r[2] }
        print
      }
    }'
}

# Fails unless every github.com account is usable: a dropped account would show its PRs as 0.
github_logins() {
  local hosts broken
  hosts=$(gh auth status --json hosts)
  broken=$(jq -r '.hosts["github.com"][]? | select(.state != "success") | .login' <<<"${hosts}")
  if [[ -n ${broken} ]]; then
    echo "==> Error: gh account not usable: ${broken//$'\n'/, }" >&2
    return 1
  fi
  if [[ $(jq '.hosts["github.com"] // [] | length' <<<"${hosts}") -eq 0 ]]; then
    echo "==> Error: no gh account for github.com. Run: gh auth login" >&2
    return 1
  fi
  jq -r '.hosts["github.com"][].login' <<<"${hosts}"
}

# Lines: "<owner/name>\t<merged epoch>"
merged_prs_of() {
  local login="$1" token cursor="" page
  token=$(gh auth token --user "${login}")
  local since
  since=$(date -d "@$((now - span_days * day))" +%Y-%m-%dT%H:%M:%S%:z)
  # shellcheck disable=SC2016
  local query='query($q: String!, $after: String) {
    search(type: ISSUE, query: $q, first: 100, after: $after) {
      pageInfo { hasNextPage endCursor }
      nodes { ... on PullRequest { repository { nameWithOwner } mergedAt } }
    }
  }'
  while true; do
    local -a args=(-f query="${query}" -f q="is:pr is:merged author:@me merged:>=${since}")
    [[ -n ${cursor} ]] && args+=(-f after="${cursor}")
    page=$(GH_TOKEN="${token}" gh api graphql "${args[@]}")
    jq -r '.data.search.nodes[] | [.repository.nameWithOwner, (.mergedAt | fromdateiso8601)] | @tsv' <<<"${page}"
    [[ $(jq -r '.data.search.pageInfo.hasNextPage' <<<"${page}") != true ]] && return 0
    cursor=$(jq -r '.data.search.pageInfo.endCursor' <<<"${page}")
  done
}

pr_events() {
  local login
  github_logins | while IFS= read -r login; do
    merged_prs_of "${login}"
  done | awk -F'\t' -v OFS='\t' '
    FILENAME == ARGV[1] { split($0, f, "\037"); if (f[4] != "") loc[f[4]] = f[2] FS f[3]; next }
    {
      where = $1 in loc ? loc[$1] : "github:" substr($1, 1, index($1, "/") - 1) FS ""
      print "pr", $2, where
    }' "${repos_file}" -
}

# Sorts rows: ~/ groups, ghq/ groups, other groups, github: groups, then total.
render() {
  awk -F'\t' -v now="${now}" -v day="${day}" -v title="velocity $(date -d "@${now}" '+%Y-%m-%d %H:%M')" '
    BEGIN {
      nm = split("commit merge pr", metrics, " ")
      nw = split("1 7 30", windows, " ")
      label["total"] = "total"
    }
    function add(key, m, t,   w) {
      for (w = 1; w <= nw; w++) if (t > now - windows[w] * day && t <= now) n[key, m, w]++
      if (t > now - windows[nw] * day && t <= now) active[key] = 1
    }
    function rank(g) { return g ~ /^~\// ? 0 : g ~ /^ghq\// ? 1 : g ~ /^github:/ ? 3 : 2 }
    $5 != "" && seen[$1, $3, $4, $5]++ { next }
    {
      add($3, $1, $2)
      add("total", $1, $2)
      label[$3] = $3
      order[$3] = rank($3) "\t" $3 "\t0"
      if ($4 == "") next
      add($3 FS $4, $1, $2)
      label[$3 FS $4] = "  " $4
      order[$3 FS $4] = rank($3) "\t" $3 "\t1" $4
    }
    function row(key,   m, w, s) {
      s = sprintf("%-" width "s", label[key])
      for (m = 1; m <= nm; m++) {
        s = s "  "
        for (w = 1; w <= nw; w++) s = s sprintf("%5d", n[key, metrics[m], w])
      }
      return s
    }
    END {
      width = length(title)
      delete active["total"]
      for (key in active) if (length(label[key]) > width) width = length(label[key])
      head = sprintf("%-" width "s", title)
      windows_head = sprintf("%-" width "s", "")
      for (m = 1; m <= nm; m++) {
        head = head sprintf("  %-15s", metrics[m])
        windows_head = windows_head "  "
        for (w = 1; w <= nw; w++) windows_head = windows_head sprintf("%5s", windows[w] "d")
      }
      sub(/ +$/, "", head)
      print "0\t" head
      print "1\t" windows_head
      for (key in active) print "2\t" order[key] "\t" row(key)
      print "3\t" row("total")
    }' | sort -t$'\t' -k1,1n -k2,2n -k3,3 -k4,4 | awk -F'\t' '{ print $NF }'
}

main() {
  set -euo pipefail
  case "${1:-}" in
    -h | --help)
      usage
      return
      ;;
    "") ;;
    *)
      usage >&2
      return 2
      ;;
  esac
  local cmd
  for cmd in git gh jq ghq; do
    command -v "${cmd}" >/dev/null && continue
    echo "==> Error: ${cmd} not found in PATH" >&2
    return 1
  done
  local now="${VELOCITY_NOW:-$(date +%s)}"
  local ghq_root
  ghq_root=$(ghq root 2>/dev/null || true)
  ghq_root=${ghq_root:-${HOME}/ghq}
  local tmp_dir
  tmp_dir=$(mktemp -d)
  # shellcheck disable=SC2064
  trap "rm -rf '${tmp_dir}'" EXIT
  local repos_file="${tmp_dir}/repos" events_file="${tmp_dir}/events"
  list_repos >"${repos_file}"
  local dir group repo
  while IFS=$'\x1f' read -r dir group repo _; do
    repo_events
  done <"${repos_file}" >"${events_file}"
  pr_events >>"${events_file}"
  render <"${events_file}"
}
main "$@"
