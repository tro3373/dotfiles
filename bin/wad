#!/usr/bin/env bash

# wad: Waydroid(LXC) の Android 画面を出すラッパー。
#   wad               full UI を1枚のウィンドウで表示。
#   wad <pkg>         アプリを単体ウィンドウで起動 (pkg は wad list で確認)。
#   wad list          インストール済みアプリ一覧。
#   wad install <apk> APK を導入。
#   wad init          初回セットアップ。イメージを落として展開する (sudo, 数百MB)。
#   wad cert          Play に弾かれた時の android_id 登録手順を出す。
#   wad size          full UI の解像度を表示。
#   wad size phone    484x1080 (Pixel 10 Pro と同じ縦横比) にする。
#   wad size tablet   既定 (ディスプレイ依存の横長) に戻す。
#   wad size <w>x<h>  任意の解像度にする。
#   wad stop          session を停止。
#   wad help          この使い方を表示 (-h/--help も可)。
#
# ad(redroid+scrcpy) との違い:
#   - ホスト GPU へ直接描画するので H264 の encode/decode 往復が無い。
#     redroid は software encoder しか持たず、そこが 26fps の天井になっていた。
#   - session は窓を閉じても残る。起動が重いので明示的に wad stop するまで生かす。

readonly unit=waydroid-container.service
readonly bridge=waydroid0
readonly system_type="${WAD_SYSTEM_TYPE:-GAPPS}" # VANILLA | FOSS | GAPPS

# full UI の解像度は persist.waydroid.{width,height} が決める。両方空だと既定の
# ディスプレイ依存 (= 横長タブレット表示) に戻る。phone は Pixel 10 Pro の縦横比
# 2.23:1 を保ったまま 1080px の縦に収めた値で、1920x1080 の横モニタに収まる。
# tablet の "x" は「両辺とも空」を表し、既定復帰と同じ経路で処理する
declare -rA sizes=([phone]=484x1080 [tablet]=x)

# waydroid の shebang は env python3 で、asdf 等の shim を先に拾うと
# system 側にしか無い dbus/gbinder を見失う。system python を明示して呼ぶ。
readonly waydroid_bin="${WAD_WAYDROID_BIN:-/usr/bin/waydroid}"
wd() { /usr/bin/python3 "$waydroid_bin" "$@"; }
sudo_wd() { sudo /usr/bin/python3 "$waydroid_bin" "$@"; }

# help は先頭の usage コメントを唯一の情報源として出す。二重管理しない
usage() { sed -n '/^# wad:/,/^#$/ s/^# \?//p' "${BASH_SOURCE[0]}"; }

has() { command -v "${1}" >&/dev/null; }
_ink() { if has ink; then ink "$@"; else cat - 1>&2; fi; }
# shellcheck disable=SC2145
_log() { echo "$(date +"%Y-%m-%d %H:%M:%S") ${@:2}" | _ink "$1"; }
log() { _log white "$*"; }
info() { _log cyan "$*"; }
warn() { _log yellow "$*"; }
die() { _log red "$*" && exit 1; }

# Docker は filter FORWARD を policy DROP にする。waydroid の nft (inet lxc) 側が
# accept しても、同じ hook の後段に居る Docker の chain で落ちて転送が死ぬ。
# nftables では base chain の accept は「そのチェーンの終了」でしかなく、他の base
# chain の評価を飛ばさない為。DOCKER-USER は Docker が公式に用意したユーザ用フックで
# Docker 自身の rule より先に評価される。Docker 未使用なら chain ごと無いので何もしない
allow_forward() {
  sudo iptables -S DOCKER-USER >&/dev/null || return 0
  local d
  for d in -i -o; do
    sudo iptables -C DOCKER-USER "$d" "$bridge" -j ACCEPT 2>/dev/null ||
      sudo iptables -I DOCKER-USER "$d" "$bridge" -j ACCEPT
  done
}

# container は systemd 側。session と違い root が要るので waydroid 自身は起こせない
container_up() {
  if ! systemctl is-active --quiet "$unit"; then
    info "==> starting $unit..."
    sudo systemctl start "$unit"
  fi
  # unit は enabled なので再起動後は既に active。だが iptables の rule は再起動で
  # 消えている。起動を跨いで直す為に active/inactive に依らず毎回通す
  allow_forward
}

# GAPPS イメージは Play Protect 未認証。Play へのログインを弾かれた時は
# android_id を Google に登録して例外扱いにしてもらう (未登録でも通ることはある)
show_cert() {
  local id
  id=$(sudo_wd shell -- sh -c \
    "sqlite3 /data/data/*/*/gservices.db 'select value from main where name = \"android_id\";'")
  log "android_id: $id"
  log "==> register it at https://www.google.com/android/uncertified"
  log "==> wait a few minutes, then: wad stop"
}

# 解像度の表示/変更。prop get/set は session 停止中でもエラーを表示するだけで
# exit 0 を返す為、黙って失敗しないよう先に session を確認する
size() {
  wd status | grep -q '^Session:[[:space:]]*RUNNING$' ||
    die "==> session is stopped. start it first: wad"

  local spec w h
  if [[ -z ${1:-} ]]; then
    w=$(wd prop get persist.waydroid.width)
    h=$(wd prop get persist.waydroid.height)
    log "size: ${w:-auto}x${h:-auto} (presets: ${!sizes[*]})"
    return
  fi

  spec=${sizes[$1]:-$1}
  [[ $spec =~ ^([0-9]*)x([0-9]*)$ ]] || die "==> Invalid size: $1 (<w>x<h> | ${!sizes[*]})"
  wd prop set persist.waydroid.width "${BASH_REMATCH[1]}"
  wd prop set persist.waydroid.height "${BASH_REMATCH[2]}"
  info "==> size=$1. restart the session to apply: wad stop && wad"
}

main() {
  set -euo pipefail
  # help は waydroid 未導入でも読めないと意味が無いので存在確認より先
  if [[ ${1:-} =~ ^(help|-h|--help)$ ]]; then
    usage
    return
  fi

  [[ -x $waydroid_bin ]] || die "==> No waydroid command exist. sudo pacman -S waydroid && wad init"

  case ${1:-} in
    init)
      shift
      info "==> waydroid init -s $system_type ..."
      sudo_wd init -s "$system_type" "$@"
      return
      ;;
    stop)
      wd session stop
      return
      ;;
    cert)
      container_up
      show_cert
      return
      ;;
    size)
      shift
      size "${1:-}"
      return
      ;;
    list | install)
      container_up
      wd app "$@" # app list / app install <apk>
      return
      ;;
  esac

  container_up
  # show-full-ui / app launch は session が落ちていれば自前で起こす
  if [[ -n ${1:-} ]]; then
    wd app launch "$@"
    return
  fi
  wd show-full-ui
}

main "$@"
