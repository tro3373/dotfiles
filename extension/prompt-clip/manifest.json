{
  "manifest_version": 3,
  "name": "Prompt Clip",
  "version": "1.0.0",
  "description": "保存したプロンプトをクリック/ショートカットでクリップボードにコピーするだけの拡張",
  "permissions": ["storage", "offscreen", "clipboardWrite"],
  "action": { "default_popup": "popup.html", "default_title": "Prompt Clip" },
  "background": { "service_worker": "background.js", "type": "module" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+O" },
      "description": "一覧を開く"
    },
    "copy-top": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "優先度1位のプロンプトをコピー"
    }
  }
}
