#!/usr/bin/env bash

install_common() {
  go_install github.com/x-motemen/ghq@latest
}

cat_add_config() {
  cat <<EOF
[ghq]
; primary is last setting
	root = ~/src
	root = ~/go/src
	root = ~/ghq
EOF
}

add_ghq_roots_to_gitconfig() {
  local _gitconfig=$HOME/.gitconfig
  if grep ghq "$_gitconfig" >&/dev/null; then
    return
  fi
  if is_dry; then
    log "==> add to $_gitconfig bellow."
    echo
    cat_add_config
    return
  fi
  cat_add_config >>"$_gitconfig"
}

link_if_absent() {
  local src=$1 lnk=$2
  if isexist "${lnk}"; then
    return
  fi
  make_link "${src}" "${lnk}"
}

is_real_dir() { [[ -d $1 && ! -L $1 ]]; }

link_dot_into_ghq() {
  local owner_dir="${HOME}/ghq/github.com/tro3373"
  if is_real_dir "${owner_dir}/dotfiles"; then
    return
  fi
  make_dir_if_needed "${owner_dir}"
  link_if_absent "${HOME}/.dot" "${owner_dir}/dotfiles"
  link_if_absent "${HOME}/.dot-worktree" "${owner_dir}/dotfiles-worktree"
}

setting_common() {
  add_ghq_roots_to_gitconfig
  link_dot_into_ghq
}
