#!/usr/bin/env bash

install_arch() {
  install_via_os_default
}
install_mac() {
  install_via_os_default
}
setting_common() {
  local dir=$HOME/.config/direnv
  make_dir_if_needed "$dir"
  # shellcheck disable=SC2154
  make_lnk_with_bkup "$app_dir/direnvrc" "$dir/direnvrc"
  setup_whitelist "$dir/direnv.toml"
}

# prefix 配下の .envrc は direnv allow なしで読み込まれる。
setup_whitelist() {
  local dst=$1
  if [[ -e $dst ]]; then
    log "==> $dst already exists."
    return
  fi
  cat <<'EOF' | cat_tee "$dst"
[whitelist]
prefix = [
]
EOF
  log "==> Add trusted dirs to whitelist.prefix in $dst (e.g. \"$HOME/ghq/github.com/you\",)"
}
