#!/usr/bin/env bash

install_common() {
  platform=$(get_platform)
  arch=$(get_arch)
  # https://github.com/cli/cli/releases/download/v2.92.0/gh_2.92.0_linux_arm64.tar.gz
  dl_gh_release cli/cli latest "*${platform}_${arch}.tar.gz"
  exe 'tar -xzf gh*.tar.gz'
  exe 'sudo cp gh*/bin/gh /usr/local/bin/'
}
install_arch() {
  # NOTE: install latest `gh` command via `gh` command.
  # - yay install gh command to /usr/bin
  # - dl_gh_release install gh command to /usr/local/bin
  # - /usr/local/bin is higher priority than /usr/bin, so dl_gh_release is used to install latest version.
  def_install github-cli
  # install_common
}
install_msys() { not_supported; }
install_cygwin() { not_supported; }
install_mac() {
  install_via_os_default
}
install_ubuntu() { not_supported; }
install_redhat() { not_supported; }
# hosts.yml は認証トークンを持つので、config.yml だけをリンクする。
setting_common() {
  local dir=$HOME/.config/gh
  make_dir_if_needed "$dir"
  # shellcheck disable=SC2154
  make_lnk_with_bkup "$app_dir/config.yml" "$dir/config.yml"
}
